From 8fe8976b53801feef1c6197d089d77b293f6b655 Mon Sep 17 00:00:00 2001
From: Noah Cylich <noahcylich@gmail.com>
Date: Sat, 14 Nov 2026 20:31:41 -0800
Subject: [PATCH] temporal-MoE: decode-time routing on the CPU path (our rule
 without training, Skliar's cache-conditional routing), several expert loads
 per token, real-text replay in llama-bench

LLAMA_TEMPORAL_ROUTE=decode follows analysis/residency/decode_state.py and LLAMA_TEMPORAL_ROUTE=skliar
follows analysis/residency/cache_bias.py (TEMPORAL_CB_C, TEMPORAL_CB_LAMBDA, TEMPORAL_CB_J): a prompt batch
is routed by the stock top-k while the rule observes it, and each single-token batch is one rule step.
Both existed only as CUDA kernels before.

Skliar can admit several experts on one token. The window op now evicts every expert that left the window
and queues all missing ones at once, so the fetch workers read them in parallel. The experts that entered
sit last in the window; the first sub-pass does not wait for them up front, and the repacked kernel
computes that layer's residents first, so the fetches run under the residents' compute.
LLAMA_TEMPORAL_TAIL=<n> ends the two-pass FFN with n single-expert sub-passes instead of one. With
LLAMA_TEMPORAL_R >= n_expert nothing is evicted (the all-in-RAM twin of the streamed path). Streamed skliar
needs TEMPORAL_CB_C equal to n_expert_used.

In these modes compute threads other than 0 poll for a streamed expert and never take the pool mutex or
sleep (ledger S1-3: blocking there gave multi-second stalls on a throttled Pixel 10a).

LLAMA_TEMPORAL_ROUTE=replay with TEMPORAL_REPLAY_HIST="c0,c1,..." is for models whose router is not
meaningful (random weights): each layer-token draws its load count from the histogram and swaps that many
random experts; the rest of the path is the one skliar uses.

Reporting: exit line temporal-route2 with the loads histogram, TEMPORAL_ROUTE_HIST, and
LLAMA_TEMPORAL_ROUTE_DUMP2 for gpubench/released/route_check.py.

llama-bench: TEMPORAL_BENCH_CTX/GEN replay real tokens, TEMPORAL_BENCH_REPREFILL fills the context again on
every repetition, TEMPORAL_BENCH_TOKLOG writes time, loads and fetch wait per decoded token, and
TEMPORAL_BENCH_LOGIT_HASH adds a hash of each token's logits.

LLAMA_TEMPORAL_ROUTE=trained is unchanged.
---
 ggml/include/ggml-cpu.h           |   7 +
 ggml/src/ggml-cpu/ggml-cpu.c      | 414 +++++++++++++++++++++++++++++-
 ggml/src/ggml-cpu/repack.cpp      |   5 +-
 src/llama-graph.cpp               |  16 +-
 tools/llama-bench/llama-bench.cpp |  75 +++++-
 5 files changed, 507 insertions(+), 10 deletions(-)

diff --git a/ggml/include/ggml-cpu.h b/ggml/include/ggml-cpu.h
index f3e72dc3..cce7b7b6 100644
--- a/ggml/include/ggml-cpu.h
+++ b/ggml/include/ggml-cpu.h
@@ -167,6 +167,13 @@ extern "C" {
     GGML_BACKEND_API int  ggml_temporal_route_trained(void);
     GGML_BACKEND_API void ggml_temporal_route_reset(void);
     GGML_BACKEND_API int  ggml_temporal_route_last(int L, int * admitted, int * evicted, const int ** window);
+    // decode-time rules (LLAMA_TEMPORAL_ROUTE=decode|skliar): loads summed over the layers and the largest
+    // per-layer load count since the previous call (then both restart from 0), and the cumulative time the
+    // compute thread spent blocked on expert fetches. For per-token attribution in llama-bench.
+    GGML_BACKEND_API void ggml_temporal_route_tokstat(uint64_t * loads, uint64_t * max_layer_loads, uint64_t * wait_ns);
+    // LLAMA_TEMPORAL_TAIL=<n> (default 1): the two-pass FFN ends with n single-expert sub-passes
+    GGML_BACKEND_API int  ggml_temporal_tail(void);
+    GGML_BACKEND_API const int * ggml_tm_src_order(const struct ggml_tensor * src0);
 
     GGML_BACKEND_API void ggml_temporal_window_fill(struct ggml_tensor * dst, int ith, int nth, void * userdata);
 
diff --git a/ggml/src/ggml-cpu/ggml-cpu.c b/ggml/src/ggml-cpu/ggml-cpu.c
index 6482f794..17906bbe 100644
--- a/ggml/src/ggml-cpu/ggml-cpu.c
+++ b/ggml/src/ggml-cpu/ggml-cpu.c
@@ -1511,7 +1511,99 @@ static int      g_tr_last_out[GGML_TR_MAXLAYER];  // last token: evicted expert,
 static uint64_t g_tr_steps[GGML_TR_MAXLAYER], g_tr_nswaps[GGML_TR_MAXLAYER], g_tr_ncold[GGML_TR_MAXLAYER];
 static FILE *   g_tr_dump = NULL;
 
+// ---- decode-time rules for a model WITHOUT temporal training (modes 2 and 3) ---------------
+// The prompt is routed by the stock top-k while the rule only observes it; the rule decides the
+// experts from the first decoded token on. A prompt batch is any batch of more than one token, a
+// decoded token is a single-token batch (one rule step each). Loads are counted on decoded tokens.
+//   LLAMA_TEMPORAL_ROUTE=decode   our rule, as analysis/residency/decode_state.py: the min_logit window
+//                                 scan runs observe-only over the prompt and seeds the decode state;
+//                                 each decoded token is one step (0 or 1 expert admitted) and routes
+//                                 inside the K residents. Ties among residents evict the lowest index.
+//   LLAMA_TEMPORAL_ROUTE=skliar   Skliar et al. (arXiv:2412.00099), as analysis/residency/cache_bias.py:
+//                                 an LRU cache of TEMPORAL_CB_C experts per layer; z' = z + lambda *
+//                                 (running mean of max(z)-min(z)) on cached experts; top-K of z'; the
+//                                 top-1 of z is always selected (TEMPORAL_CB_J = 1; 0 turns it off);
+//                                 loads = selected experts that were not cached. Any number of experts
+//                                 can enter per token. TEMPORAL_CB_LAMBDA sets lambda. The prompt warms
+//                                 the cache (its C most recently used experts). With C = K the cache is
+//                                 the previous selection, and the biased top-K is reached by exchanging
+//                                 the best outsider with the weakest member until it stops winning
+//                                 (TEMPORAL_CB_FULLSEL=1 runs the plain top-K selection instead).
+// In both modes the window lists the experts kept from the previous token first and the ones that
+// entered on this token last, so the two-pass FFN waits only where bytes can be missing.
+//   exit line `temporal-route2: ...` with loads per decoded layer-token and their histogram
+//   TEMPORAL_ROUTE_HIST=<json>         {"hist","loads","rows"} like cache_bias.stats()
+//   LLAMA_TEMPORAL_ROUTE_DUMP2=<file>  per layer and token: int32 layer, n_tokens, t, loads (-1 if not
+//                                      a counted decode step), K int32 ids, E float32 logits; a record
+//                                      with layer -1 marks a sequence reset (gpubench/released/route_check.py)
+#define GGML_TR2_HIST 64
+static int      g_tr2_mode = 0, g_tr2_K = 0, g_tr2_E = 0;
+static int      g_sk_C = 0, g_sk_J = 1, g_sk_fullsel = 0;
+static double   g_sk_lam = 0.0;
+static int64_t  g_sk_last[GGML_TR_MAXLAYER][GGML_TR_MAXE];    // skliar: step of last use, -1 = not cached
+static int64_t  g_sk_t[GGML_TR_MAXLAYER];
+static double   g_sk_dsum[GGML_TR_MAXLAYER];                  // running mean of max-min: per layer, per process
+static uint64_t g_sk_dn[GGML_TR_MAXLAYER];
+static int      g_tr2_nnew[GGML_TR_MAXLAYER];                 // last single-token step: experts that entered the window
+static uint64_t g_tr2_hist[GGML_TR2_HIST], g_tr2_rows, g_tr2_loads, g_tr2_prompt, g_tr2_cold;
+static uint64_t g_tr2_layer_seen[GGML_TR_MAXLAYER];
+static uint64_t g_tr2_tok_loads, g_tr2_tok_max;               // since the last ggml_temporal_route_tokstat
+static FILE *   g_tr_dump2 = NULL;
+static double   g_rp_cum[GGML_TR2_HIST], g_rp_tot = 0.0;      // replay: cumulative histogram of load counts
+static int      g_rp_n = 0;
+static uint64_t g_rp_rng[GGML_TR_MAXLAYER];
+static int      g_rp_out[GGML_TR_MAXK];
+static uint64_t ggml_tm_wait_ns_total(void);
+
+static void ggml_tr2_init(int mode) {
+    g_tr2_mode = mode;
+    if (mode == 3) {
+        const char * c = getenv("TEMPORAL_CB_C"), * l = getenv("TEMPORAL_CB_LAMBDA"), * j = getenv("TEMPORAL_CB_J");
+        if (!c || !l) { fprintf(stderr, "temporal-route: FATAL LLAMA_TEMPORAL_ROUTE=skliar needs TEMPORAL_CB_C and TEMPORAL_CB_LAMBDA\n"); abort(); }
+        g_sk_C = atoi(c); g_sk_lam = strtod(l, NULL); g_sk_J = j ? atoi(j) : 1;
+        if (g_sk_C < 1 || (g_sk_J != 0 && g_sk_J != 1)) { fprintf(stderr, "temporal-route: FATAL TEMPORAL_CB_C >= 1 and TEMPORAL_CB_J in {0,1}\n"); abort(); }
+        const char * f = getenv("TEMPORAL_CB_FULLSEL"); g_sk_fullsel = (f && atoi(f)) ? 1 : 0;
+    }
+    if (mode == 4) {
+        // LLAMA_TEMPORAL_ROUTE=replay: for models whose router is not meaningful (random weights). The logits
+        // are ignored on decoded tokens; each layer-token draws a load count m from the histogram
+        // TEMPORAL_REPLAY_HIST="c0,c1,c2,..." (weights for 0, 1, 2, ... loads), drops m random residents and
+        // admits m random outsiders. "0,1" is exactly one load per layer per token. Draws are independent
+        // across layers and tokens. Everything after the route op is the path the skliar mode uses.
+        const char * h = getenv("TEMPORAL_REPLAY_HIST");
+        if (!h) { fprintf(stderr, "temporal-route: FATAL LLAMA_TEMPORAL_ROUTE=replay needs TEMPORAL_REPLAY_HIST\n"); abort(); }
+        g_rp_n = 0; g_rp_tot = 0.0;
+        for (const char * q = h; *q && g_rp_n < GGML_TR2_HIST; ) {
+            char * e; const double v = strtod(q, &e); if (e == q) break;
+            g_rp_tot += v; g_rp_cum[g_rp_n++] = g_rp_tot; q = (*e == ',') ? e + 1 : e;
+        }
+        if (g_rp_n == 0 || g_rp_tot <= 0.0) { fprintf(stderr, "temporal-route: FATAL bad TEMPORAL_REPLAY_HIST\n"); abort(); }
+    }
+    const char * d = getenv("LLAMA_TEMPORAL_ROUTE_DUMP2");
+    if (d && d[0]) { g_tr_dump2 = fopen(d, "wb"); if (!g_tr_dump2) { fprintf(stderr, "temporal-route: FATAL cannot open %s\n", d); abort(); } }
+}
+
+static void ggml_tr2_report(void) {
+    int nl = 0, H = 1;
+    for (int L = 0; L < GGML_TR_MAXLAYER; L++) if (g_tr2_layer_seen[L]) nl++;
+    for (int i = 0; i < GGML_TR2_HIST; i++) if (g_tr2_hist[i]) H = i + 1;
+    fprintf(stderr, "temporal-route2: mode=%s layers=%d decode_layer_tokens=%llu loads=%llu loads_per_layer_token=%.4f "
+            "prompt_layer_tokens=%llu cold_decode=%llu C=%d lambda=%.4f J=%d hist=[", g_tr2_mode == 2 ? "decode" : g_tr2_mode == 4 ? "replay" : "skliar", nl,
+            (unsigned long long) g_tr2_rows, (unsigned long long) g_tr2_loads,
+            g_tr2_rows ? (double) g_tr2_loads / (double) g_tr2_rows : 0.0,
+            (unsigned long long) g_tr2_prompt, (unsigned long long) g_tr2_cold, g_sk_C, g_sk_lam, g_sk_J);
+    for (int i = 0; i < H; i++) fprintf(stderr, "%s%llu", i ? "," : "", (unsigned long long) g_tr2_hist[i]);
+    fprintf(stderr, "]\n");
+    const char * hp = getenv("TEMPORAL_ROUTE_HIST");
+    if (hp && hp[0]) { FILE * f = fopen(hp, "w"); if (f) {
+        fprintf(f, "{\"hist\": ["); for (int i = 0; i < GGML_TR2_HIST; i++) fprintf(f, "%s%llu", i ? ", " : "", (unsigned long long) g_tr2_hist[i]);
+        fprintf(f, "], \"loads\": %llu, \"rows\": %llu, \"mode\": \"%s\"}\n", (unsigned long long) g_tr2_loads,
+                (unsigned long long) g_tr2_rows, g_tr2_mode == 2 ? "decode" : "skliar"); fclose(f); } }
+    if (g_tr_dump2) { fclose(g_tr_dump2); g_tr_dump2 = NULL; }
+}
+
 static void ggml_tr_report(void) {
+    if (g_tr2_mode) { ggml_tr2_report(); return; }
     uint64_t st = 0, sw = 0, co = 0; int nl = 0;
     for (int L = 0; L < GGML_TR_MAXLAYER; L++) {
         if (!g_tr_steps[L]) continue;
@@ -1528,12 +1620,16 @@ int ggml_temporal_route_trained(void) {
     if (mode < 0) {
         const char * r = getenv("LLAMA_TEMPORAL_ROUTE");
         if (r && strcmp(r, "trained") == 0)     mode = 1;
+        else if (r && strcmp(r, "decode") == 0) mode = 2;   // our rule at decode time, model without temporal training
+        else if (r && strcmp(r, "skliar") == 0) mode = 3;   // Skliar et al. cache-conditional routing
+        else if (r && strcmp(r, "replay") == 0) mode = 4;   // imposed load counts drawn from TEMPORAL_REPLAY_HIST
         else if (r && strcmp(r, "random") == 0) mode = 0;
         else if (r && r[0]) { fprintf(stderr, "temporal-route: FATAL unknown LLAMA_TEMPORAL_ROUTE=%s\n", r); abort(); }
         else mode = getenv("LLAMA_TEMPORAL_TWOPASS") ? 1 : 0;
         if (mode) {
             const char * d = getenv("LLAMA_TEMPORAL_ROUTE_DUMP");
             if (d && d[0]) { g_tr_dump = fopen(d, "wb"); if (!g_tr_dump) { fprintf(stderr, "temporal-route: FATAL cannot open %s\n", d); abort(); } }
+            if (mode >= 2) { ggml_tr2_init(mode); }
             atexit(ggml_tr_report);
         }
     }
@@ -1542,6 +1638,19 @@ int ggml_temporal_route_trained(void) {
 
 void ggml_temporal_route_reset(void) {
     memset(g_tr_k, 0, sizeof(g_tr_k));
+    memset(g_sk_t, 0, sizeof(g_sk_t));
+    if (g_tr_dump2 && g_tr2_K) {                        // sequence start marker: layer -1, rest zero
+        int32_t z[4] = { -1, 0, 0, 0 }; fwrite(z, 4, 4, g_tr_dump2);
+        static const int32_t zero = 0;
+        for (int i = 0; i < g_tr2_K + g_tr2_E; i++) fwrite(&zero, 4, 1, g_tr_dump2);
+    }
+}
+
+void ggml_temporal_route_tokstat(uint64_t * loads, uint64_t * max_layer_loads, uint64_t * wait_ns) {
+    if (loads)           *loads = g_tr2_tok_loads;
+    if (max_layer_loads) *max_layer_loads = g_tr2_tok_max;
+    if (wait_ns)         *wait_ns = ggml_tm_wait_ns_total();
+    g_tr2_tok_loads = 0; g_tr2_tok_max = 0;
 }
 
 int ggml_temporal_route_last(int L, int * admitted, int * evicted, const int ** window) {
@@ -1552,6 +1661,207 @@ int ggml_temporal_route_last(int L, int * admitted, int * evicted, const int **
     return g_tr_k[L];
 }
 
+// top-K of x, highest first, ties to the lower index; `in` gets the membership flags
+static void ggml_tr2_topk(const float * x, int E, int K, int * ids, uint8_t * in) {
+    memset(in, 0, (size_t) E);
+    for (int j = 0; j < K; j++) {
+        int b = -1;
+        for (int e = 0; e < E; e++) if (!in[e] && (b < 0 || x[e] > x[b])) b = e;
+        ids[j] = b; in[b] = 1;
+    }
+}
+
+// our rule, one token: cold fill, or admit the best outsider iff it beats the worst resident.
+// Returns the number of experts that entered (0 or 1; K on a cold fill).
+static int ggml_tr2_decode_step(int L, const float * x, int E, int K) {
+    int * win = g_tr_win[L];
+    uint8_t * in = g_tr_in[L];
+    if (g_tr_k[L] != K) { ggml_tr2_topk(x, E, K, win, in); g_tr_k[L] = K; return K; }
+    int nom = -1, ws = 0;
+    for (int e = 0; e < E; e++) if (!in[e] && (nom < 0 || x[e] > x[nom])) nom = e;
+    for (int j = 1; j < K; j++) {                           // lowest logit; ties evict the lowest expert index
+        if (x[win[j]] < x[win[ws]] || (x[win[j]] == x[win[ws]] && win[j] < win[ws])) ws = j;
+    }
+    if (!(x[nom] > x[win[ws]])) return 0;
+    in[win[ws]] = 0;
+    if (ws != K - 1) win[ws] = win[K - 1];                  // the previous newcomer fills the gap
+    win[K - 1] = nom; in[nom] = 1;                          // the newcomer sits in slot K-1
+    return 1;
+}
+
+// Skliar, a prompt batch (or the first token of a sequence that has no prompt): unbiased, warms the cache
+static void ggml_tr2_skliar_warm(int L, const float * lg, size_t stride, int n_tokens, int E, int K, int32_t * out) {
+    int * win = g_tr_win[L];
+    uint8_t * in = g_tr_in[L];
+    int64_t * last = g_sk_last[L];
+    for (int e = 0; e < E; e++) last[e] = -1;
+    for (int t = 0; t < n_tokens; t++) {
+        const float * x = (const float *) ((const char *) lg + (size_t) t * stride);
+        float mx = x[0], mn = x[0];
+        for (int e = 1; e < E; e++) { if (x[e] > mx) mx = x[e]; if (x[e] < mn) mn = x[e]; }
+        g_sk_dsum[L] += (double) (mx - mn); g_sk_dn[L]++;
+        ggml_tr2_topk(x, E, K, win, in);
+        for (int j = 0; j < K; j++) { last[win[j]] = t; out[(size_t) t * K + j] = win[j]; }
+    }
+    int cached = 0;
+    for (int e = 0; e < E; e++) cached += last[e] >= 0;
+    for (; cached > g_sk_C; cached--) {                     // keep the C most recently used (ties keep the higher index)
+        int w = -1;
+        for (int e = 0; e < E; e++) if (last[e] >= 0 && (w < 0 || last[e] < last[w])) w = e;
+        last[w] = -1;
+    }
+    g_sk_t[L] += n_tokens;
+    g_tr_k[L] = K;                                          // win / in hold the last token's selection
+}
+
+// Skliar, one decoded token. Returns the loads (selected experts that were not cached); *n_new gets the
+// number of experts that were not in the previous token's selection (they sit at the end of the window).
+static int ggml_tr2_skliar_step(int L, const float * x, int E, int K, int * n_new) {
+    static uint8_t cur[GGML_TR_MAXE];
+    static int     keep[GGML_TR_MAXK];
+    int * win = g_tr_win[L];
+    uint8_t * in = g_tr_in[L];
+    int64_t * last = g_sk_last[L];
+    float mx = x[0], mn = x[0]; int t1 = 0;
+    for (int e = 1; e < E; e++) { if (x[e] > mx) { mx = x[e]; t1 = e; } if (x[e] < mn) mn = x[e]; }
+    g_sk_dsum[L] += (double) (mx - mn); g_sk_dn[L]++;
+    const float b = (float) (g_sk_lam * (g_sk_dsum[L] / (double) g_sk_dn[L]));
+#define GGML_SK_ZB(e) (last[e] >= 0 ? x[e] + b : x[e])
+    if (g_sk_C == K && !g_sk_fullsel) {
+        // the cache is the previous selection: exchange the best outsider with the weakest member while it wins
+        memcpy(cur, in, (size_t) E);
+        for (;;) {
+            int nom = -1, ws = -1; float zn = 0.0f, zw = 0.0f;
+            for (int e = 0; e < E; e++) {
+                const float z = GGML_SK_ZB(e);
+                if (cur[e]) { if (ws < 0 || z < zw)  { ws = e;  zw = z; } }
+                else        { if (nom < 0 || z > zn) { nom = e; zn = z; } }
+            }
+            if (!(zn > zw)) break;
+            cur[ws] = 0; cur[nom] = 1;
+        }
+    } else {                                                // plain top-K of z'
+        memset(cur, 0, (size_t) E);
+        for (int j = 0; j < K; j++) {
+            int bi = -1; float zbst = 0.0f;
+            for (int e = 0; e < E; e++) if (!cur[e]) { const float z = GGML_SK_ZB(e); if (bi < 0 || z > zbst) { bi = e; zbst = z; } }
+            cur[bi] = 1;
+        }
+    }
+    if (g_sk_J >= 1 && !cur[t1]) {                          // the top-1 of z is always selected
+        int ws = -1; float zw = 0.0f;
+        for (int e = 0; e < E; e++) if (cur[e]) { const float z = GGML_SK_ZB(e); if (ws < 0 || z < zw) { ws = e; zw = z; } }
+        cur[ws] = 0; cur[t1] = 1;
+    }
+#undef GGML_SK_ZB
+    int nk = 0, loads = 0, nn = 0;
+    for (int j = 0; j < K; j++) if (cur[win[j]]) keep[nk++] = win[j];       // kept from the previous token, in place
+    const int64_t t = g_sk_t[L]++;
+    for (int e = 0; e < E; e++) {
+        if (!cur[e]) continue;
+        if (last[e] < 0) loads++;
+        if (!in[e]) { win[nk + nn] = e; nn++; }                               // entered on this token: end of the window
+        last[e] = t;
+    }
+    for (int j = 0; j < nk; j++) win[j] = keep[j];
+    if (g_sk_C == K) {
+        for (int e = 0; e < E; e++) if (!cur[e]) last[e] = -1;                // the cache is exactly the selection
+    } else {
+        int cached = 0;
+        for (int e = 0; e < E; e++) cached += last[e] >= 0;
+        for (; cached > g_sk_C; cached--) {
+            int w = -1;
+            for (int e = 0; e < E; e++) if (last[e] >= 0 && (w < 0 || last[e] < last[w])) w = e;
+            last[w] = -1;
+        }
+    }
+    memcpy(in, cur, (size_t) E);
+    *n_new = nn;
+    return loads;
+}
+
+// replay, one decoded token: m loads drawn from the histogram, random residents out, random outsiders in
+static int ggml_tr2_replay_step(int L, int E, int K) {
+    int * win = g_tr_win[L];
+    uint8_t * in = g_tr_in[L];
+    uint64_t x = g_rp_rng[L];
+    if (!x) x = 0x9E3779B97F4A7C15ull ^ (0x100000001b3ull * (uint64_t)(L + 1));
+#define GGML_RP_NEXT() (x ^= x << 13, x ^= x >> 7, x ^= x << 17, x)
+    const double u = (double) (GGML_RP_NEXT() >> 11) / 9007199254740992.0 * g_rp_tot;
+    int m = 0;
+    while (m < g_rp_n - 1 && u >= g_rp_cum[m]) m++;
+    if (m > K) m = K;
+    if (m > E - K) m = E - K;
+    for (int j = 0; j < m; j++) {                           // move m random residents to the end of the window
+        const int a = (int) (GGML_RP_NEXT() % (uint64_t) (K - j));
+        const int t = win[a]; win[a] = win[K - 1 - j]; win[K - 1 - j] = t;
+    }
+    for (int j = 0; j < m; j++) in[win[K - 1 - j]] = 2;     // leaving: not admissible on this token
