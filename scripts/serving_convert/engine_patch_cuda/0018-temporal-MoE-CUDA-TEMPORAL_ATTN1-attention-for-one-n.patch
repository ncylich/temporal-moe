From c1741cbe22763fc4d03811482b52ea56120a7d13 Mon Sep 17 00:00:00 2001
From: Noah Cylich <noahcylich@gmail.com>
Date: Wed, 18 Nov 2026 14:51:14 -0800
Subject: [PATCH] temporal-MoE CUDA: TEMPORAL_ATTN1, attention for one new
 token without flash attention as one launch

MUL_MAT (K.Q), SOFT_MAX, MUL_MAT (V.softmax), PERMUTE and CONT on a single-token step become one launch
with one block per head. Each phase writes the buffer the stock op would have written with the stock
arithmetic: K.Q in the vector kernel's order where the stock engine uses that kernel and, where it
calls cuBLAS (F16 K with more than 512 rows), in the order cuBLAS's result has for 16 columns (two
chains of fused multiply-adds over columns 0..7 and 8..15, then one add; found by trying orders against
cuBLAS, 16-dimensional heads only); the masked softmax by the stock kernel's body; V.softmax in the
vector kernel's half-precision order. Declines anything else, and leaves CONT to the stock op when
its buffer overlaps the softmax's.

TEMPORAL_ATTN1_CHECK=1 (debugging, with GGML_CUDA_DISABLE_GRAPHS=1) runs the stock ops and the kernel
on the same inputs and counts differing values of K.Q and of the output per cache size.
TEMPORAL_ATTN1=9 and TEMPORAL_ATTN1_STOP are timing switches (output wrong).

Off by default.
---
 ggml/src/ggml-cuda/ggml-cuda.cu |  65 +++++++++
 ggml/src/ggml-cuda/softmax.cu   | 233 ++++++++++++++++++++++++++++++--
 ggml/src/ggml-cuda/softmax.cuh  |   3 +
 3 files changed, 291 insertions(+), 10 deletions(-)

diff --git a/ggml/src/ggml-cuda/ggml-cuda.cu b/ggml/src/ggml-cuda/ggml-cuda.cu
index 59439595..aea58cda 100644
--- a/ggml/src/ggml-cuda/ggml-cuda.cu
+++ b/ggml/src/ggml-cuda/ggml-cuda.cu
@@ -3334,6 +3334,50 @@ static bool ggml_cuda_can_fuse(const struct ggml_cgraph *                cgraph,
 }
 
 // try and fuse nodes and return the number of nodes to skip
+// TEMPORAL_ATTN1_CHECK=1 (debugging, with GGML_CUDA_DISABLE_GRAPHS=1): run the four stock ops, then the single-token
+// attention kernel on the same inputs, and compare K.Q before the softmax and the final output bit for bit. The stock
+// results are left in place. Totals per cache size are printed at exit.
+static bool ggml_cuda_compute_forward(ggml_backend_cuda_context & ctx, struct ggml_tensor * dst);
+static bool tm_attn1_check(ggml_backend_cuda_context * cuda_ctx, ggml_tensor * kq, ggml_tensor * sm, ggml_tensor * kqv, ggml_tensor * cont) {
+    static const int on = [](){const char*e=getenv("TEMPORAL_ATTN1_CHECK");return e?atoi(e):0;}();
+    if (!on) return false;
+    struct tot_t { long calls[32] = {0}, taken[32] = {0}, n_out[32] = {0}, bad_out[32] = {0}, n_kq[32] = {0}, bad_kq[32] = {0};
+        ~tot_t() { for (int b = 0; b < 32; ++b) if (calls[b]) fprintf(stderr, "temporal-attn1-check: %4d cached positions: %ld attention calls, kernel taken in %ld | "
+            "K.Q at unmasked positions: %ld of %ld values differ from the stock op | attention output: %ld of %ld values differ\n",
+            (b + 1) * 256, calls[b], taken[b], bad_kq[b], n_kq[b], bad_out[b], n_out[b]); } };
+    static tot_t T;
+    cudaStream_t st = cuda_ctx->stream();
+    const size_t n_kq = ggml_nelements(kq), n_out = ggml_nelements(cont), nkv = kq->ne[0];
+    const int b = std::min<int>(31, (int) (nkv / 256) - 1);
+    // the allocator may give an output Q's buffer, and SOFT_MAX works in place over K.Q, so inputs are saved and put back
+    const ggml_tensor * q = kq->src[1];
+    std::vector<char> q0(ggml_nbytes(q)); std::vector<float> raw0(n_kq), raw1(n_kq), sm0(n_kq), out0(n_out), out1(n_out), kqv0(ggml_nelements(kqv)), mk(nkv, 0.0f);
+    CUDA_CHECK(cudaStreamSynchronize(st)); CUDA_CHECK(cudaMemcpy(q0.data(), q->data, q0.size(), cudaMemcpyDeviceToHost));
+    { bool ok = ggml_cuda_compute_forward(*cuda_ctx, kq); GGML_ASSERT(ok); }
+    CUDA_CHECK(cudaStreamSynchronize(st)); CUDA_CHECK(cudaMemcpy(raw0.data(), kq->data, n_kq * 4, cudaMemcpyDeviceToHost));
+    for (ggml_tensor * t : { sm, kqv, cont }) { bool ok = ggml_cuda_compute_forward(*cuda_ctx, t); GGML_ASSERT(ok); }
+    CUDA_CHECK(cudaStreamSynchronize(st));
+    CUDA_CHECK(cudaMemcpy(sm0.data(), sm->data, n_kq * 4, cudaMemcpyDeviceToHost)); CUDA_CHECK(cudaMemcpy(out0.data(), cont->data, n_out * 4, cudaMemcpyDeviceToHost));
+    CUDA_CHECK(cudaMemcpy(kqv0.data(), kqv->data, kqv0.size() * 4, cudaMemcpyDeviceToHost));
+    if (sm->src[1] && sm->src[1]->type == GGML_TYPE_F32) CUDA_CHECK(cudaMemcpy(mk.data(), sm->src[1]->data, nkv * 4, cudaMemcpyDeviceToHost));
+    T.calls[b]++;
+    CUDA_CHECK(cudaMemcpy(q->data, q0.data(), q0.size(), cudaMemcpyHostToDevice));
+    if (ggml_cuda_attn1(*cuda_ctx, kq, sm, kqv, cont, 1) != 0) {                // K.Q only
+        CUDA_CHECK(cudaStreamSynchronize(st)); CUDA_CHECK(cudaMemcpy(raw1.data(), kq->data, n_kq * 4, cudaMemcpyDeviceToHost));
+        CUDA_CHECK(cudaMemcpy(q->data, q0.data(), q0.size(), cudaMemcpyHostToDevice));
+        const int r = ggml_cuda_attn1(*cuda_ctx, kq, sm, kqv, cont, 0);         // everything
+        if (r == 2) { bool ok = ggml_cuda_compute_forward(*cuda_ctx, cont); GGML_ASSERT(ok); }
+        CUDA_CHECK(cudaStreamSynchronize(st)); CUDA_CHECK(cudaMemcpy(out1.data(), cont->data, n_out * 4, cudaMemcpyDeviceToHost));
+        T.taken[b]++; T.n_out[b] += n_out;
+        for (size_t e = 0; e < n_out; ++e) if (memcmp(&out0[e], &out1[e], 4) != 0) T.bad_out[b]++;
+        for (size_t e = 0; e < n_kq; ++e) if (mk[e % nkv] == 0.0f) { T.n_kq[b]++; if (memcmp(&raw0[e], &raw1[e], 4) != 0) T.bad_kq[b]++; }
+    }
+    // put the stock results back
+    CUDA_CHECK(cudaMemcpy(sm->data, sm0.data(), n_kq * 4, cudaMemcpyHostToDevice)); CUDA_CHECK(cudaMemcpy(kqv->data, kqv0.data(), kqv0.size() * 4, cudaMemcpyHostToDevice));
+    CUDA_CHECK(cudaMemcpy(cont->data, out0.data(), n_out * 4, cudaMemcpyHostToDevice));
+    return true;
+}
+
 static int ggml_cuda_try_fuse(ggml_backend_cuda_context * cuda_ctx, ggml_cgraph * cgraph, int i) {
 
     static bool disable_fusion = getenv("GGML_CUDA_DISABLE_FUSION") != nullptr && std::atoi(getenv("GGML_CUDA_DISABLE_FUSION"));
@@ -3343,6 +3387,27 @@ static int ggml_cuda_try_fuse(ggml_backend_cuda_context * cuda_ctx, ggml_cgraph
 
     ggml_tensor * node = cgraph->nodes[i];
 
+    // temporal, TEMPORAL_ATTN1=1: MUL_MAT (K.Q), SOFT_MAX, MUL_MAT (V.softmax), PERMUTE, CONT for one token: one launch
+    static const int tm_attn1 = [](){const char*e=getenv("TEMPORAL_ATTN1");return e?atoi(e):0;}();
+    if (tm_attn1 && node->op == GGML_OP_MUL_MAT && node->src[0]->type == GGML_TYPE_F16 && i + 4 < cgraph->n_nodes) {
+        ggml_tensor * sm = cgraph->nodes[i + 1], * kqv = cgraph->nodes[i + 2], * perm = cgraph->nodes[i + 3], * cont = cgraph->nodes[i + 4];
+        if (sm->op == GGML_OP_SOFT_MAX && kqv->op == GGML_OP_MUL_MAT && perm->op == GGML_OP_PERMUTE && cont->op == GGML_OP_CONT &&
+            perm->src[0] == kqv && cont->src[0] == perm && ggml_get_op_params_i32(perm, 0) == 0 && ggml_get_op_params_i32(perm, 1) == 2 &&
+            ggml_get_op_params_i32(perm, 2) == 1 && ggml_get_op_params_i32(perm, 3) == 3 &&
+            (sm->flags & GGML_TENSOR_FLAG_COMPUTE) && (kqv->flags & GGML_TENSOR_FLAG_COMPUTE) && (cont->flags & GGML_TENSOR_FLAG_COMPUTE) &&
+            (sm->flags & GGML_TENSOR_FLAG_COMPUTE)) {
+            if (tm_attn1 == 9) return 4;                                        // profiling: launch nothing, output wrong
+            if (tm_attn1_check(cuda_ctx, node, sm, kqv, cont)) return 4;
+            static const int tm_attn1_stop = [](){const char*e=getenv("TEMPORAL_ATTN1_STOP");return e?atoi(e):0;}();   // profiling: 1 = K.Q only, 2 = and the softmax (output wrong)
+            const int r = ggml_cuda_attn1(*cuda_ctx, node, sm, kqv, cont, tm_attn1_stop);
+            if (r != 0) {
+                if (r == 2) { bool ok = ggml_cuda_compute_forward(*cuda_ctx, cont); GGML_ASSERT(ok); }
+                static bool said = false; if (!said) { said = true; fprintf(stderr, "temporal-attn1: K.Q, softmax, V.softmax and the copy of %s in one launch\n", cont->name); }
+                return 4;
+            }
+        }
+    }
+
     // temporal, TEMPORAL_ROPE_PAIR=1: ROPE (Q), then after nodes that compute nothing ROPE + VIEW + SET_ROWS (K into the
     // cache), then after more such nodes optionally SET_ROWS (V into the cache): one launch for all of it.
     static const int tm_rpair = [](){const char*e=getenv("TEMPORAL_ROPE_PAIR");return e?atoi(e):0;}();
diff --git a/ggml/src/ggml-cuda/softmax.cu b/ggml/src/ggml-cuda/softmax.cu
index 285c0e95..69981b9f 100644
--- a/ggml/src/ggml-cuda/softmax.cu
+++ b/ggml/src/ggml-cuda/softmax.cu
@@ -1,6 +1,8 @@
 #include "common.cuh"
 #include "ggml.h"
 #include "softmax.cuh"
+#include "mmvf.cuh"
+#include "mmf.cuh"
 
 #ifdef GGML_USE_HIP
 #include <hip/hip_cooperative_groups.h>
@@ -51,20 +53,16 @@ struct soft_max_params {
 #pragma clang diagnostic push
 #pragma clang diagnostic ignored "-Wpass-failed"
 #endif // __clang__
+// The kernel's body, shared with the single-token attention kernel below (temporal, TEMPORAL_ATTN1): the block's row
+// is given by the caller instead of being read from blockIdx.
 template <bool use_shared, int ncols_template, int block_size_template, typename T>
-static __global__ void soft_max_f32(
-        const float * x, const T * mask, const float * sinks, float * dst, const soft_max_params p) {
+static __device__ __forceinline__ void soft_max_f32_body(
+        const float * x, const T * mask, const float * sinks, float * dst, const soft_max_params p,
+        const int64_t i01, const int64_t i02, const int64_t i03, const int rowx, float * data_soft_max_f32) {
     const int ncols = ncols_template == 0 ? p.ncols : ncols_template;
 
     const int tid  = threadIdx.x;
 
-    const int64_t i03 = blockIdx.z;
-    const int64_t i02 = blockIdx.y;
-    const int64_t i01 = blockIdx.x;
-
-    //TODO: noncontigous inputs/outputs
-    const int rowx = blockIdx.x + blockIdx.y * gridDim.x + blockIdx.z * gridDim.x * gridDim.y;
-
     const int64_t i11 = i01;
     const int64_t i12 = i02 % p.ne12;
     const int64_t i13 = i03 % p.ne13;
@@ -77,7 +75,6 @@ static __global__ void soft_max_f32(
 
     const float slope = get_alibi_slope(p.max_bias, i02, p.n_head_log2, p.m0, p.m1);
 
-    extern __shared__ float data_soft_max_f32[];
     float * buf_iw = data_soft_max_f32; // shared memory buffer for inter-warp communication
     // shared memory buffer to cache values between iterations:
     float * vals = use_shared ? buf_iw + WARP_SIZE : dst;
@@ -137,6 +134,117 @@ static __global__ void soft_max_f32(
     }
 }
 
+template <bool use_shared, int ncols_template, int block_size_template, typename T>
+static __global__ void soft_max_f32(
+        const float * x, const T * mask, const float * sinks, float * dst, const soft_max_params p) {
+    extern __shared__ float data_soft_max_f32[];
+    //TODO: noncontigous inputs/outputs
+    soft_max_f32_body<use_shared, ncols_template, block_size_template, T>(x, mask, sinks, dst, p, blockIdx.x, blockIdx.y, blockIdx.z,
+        blockIdx.x + blockIdx.y * gridDim.x + blockIdx.z * gridDim.x * gridDim.y, data_soft_max_f32);
+}
+
+// temporal, TEMPORAL_ATTN1=1. Attention for one new token without flash attention, as one launch with one block of
+// 1024 threads per head, in place of MUL_MAT (K.Q), SOFT_MAX, MUL_MAT (V.softmax) and the CONT that follows. Each
+// phase writes the buffer the stock op would have written and reproduces its arithmetic:
+//  1. K.Q, one thread per cached position. Which order depends on what the stock engine would have run:
+//     kq_order 0, mul_mat_vec_f<half, float, 1, 32> (K has at most 512 rows on this GPU): one block per (head,
+//       position) with the nd/2 column pairs in the first lanes of a warp and a warp sum. The pair products are
+//       formed with the same ggml_cuda_mad calls and added in the order of the 32-lane reduction (empty lanes +0).
+//     kq_order 1, cuBLAS batched SGEMM on a float copy of K (more rows): for 16 columns its result is two chains of
+//       fused multiply-adds, columns 0..7 and 8..15, then one add. Found by trying orders against cuBLAS and
+//       checked on 44,275,200 values (TEMPORAL_ATTN1_CHECK); only used for nd == 16.
+//  2. the masked softmax: soft_max_f32_body, the stock kernel's body, with this block as its block.
+//  3. V.softmax: mul_mat_vec_f<half, half, 1, bs3> has one block of bs3 threads per (head, dim); thread v sums its
+//     column pairs in half precision, warps reduce, the warp sums are reduced by the first warp. Here a warp of this
+//     block plays each of those warps in turn (lanes are lanes), then warp d reduces dim d's warp sums.
+template <typename T>
+static __global__ void attn1_f32(const half * K, const int sk1, const int sk2, const float * Q, const int sq2, float * KQ, const int skq2,
+                                 const T * mask, float * SM, const soft_max_params p,
+                                 const half * V, const int sv1, const int sv2, float * KQV, const int skqv2, float * OUT,
+                                 const int nd, const int bs3, const int kq_order, const int stop) {
+    extern __shared__ float data_attn1[];
+    const int h = blockIdx.x, tid = threadIdx.x, lane = tid % WARP_SIZE, warp = tid / WARP_SIZE, nkv = p.ncols;
+
+    if (stop != 20) {
+        const float2 * y2 = (const float2 *) (Q + (int64_t) h * sq2);
+        for (int pos = tid; pos < nkv; pos += blockDim.x) {
+            const half2 * x2 = (const half2 *) (K + (int64_t) h * sk2 + (int64_t) pos * sk1);
+            float r;
+            if (kq_order == 1) {
+                float c0 = 0.0f, c1 = 0.0f;
+#pragma unroll
+                for (int v = 0; v < 4; ++v) {
+                    const float2 tx0 = __half22float2(x2[v]),     ty0 = y2[v];
+                    const float2 tx1 = __half22float2(x2[v + 4]), ty1 = y2[v + 4];
+                    c0 = fmaf(tx0.x, ty0.x, c0); c0 = fmaf(tx0.y, ty0.y, c0);
+                    c1 = fmaf(tx1.x, ty1.x, c1); c1 = fmaf(tx1.y, ty1.y, c1);
+                }
+                r = __fadd_rn(c0, c1);
+            } else {
+                // lanes [0, nd/2) of a 32-lane warp hold the pair sums, the others +0; warp_reduce_sum's order for lane 0
+                float l[16];
+#pragma unroll
+                for (int v = 0; v < 16; ++v) {
+                    float sumf = 0.0f;
+                    if (v < nd / 2) {
+                        const float2 tmpx = __half22float2(x2[v]);
+                        const float2 tmpy = y2[v];
+                        ggml_cuda_mad(sumf, tmpx.x, tmpy.x);
+                        ggml_cuda_mad(sumf, tmpx.y, tmpy.y);
+                    }
+                    l[v] = __fadd_rn(sumf, 0.0f);                              // offset 16: lanes 16.. are +0
+                }
+#pragma unroll
+                for (int x = 0; x < 8; ++x) l[x] = __fadd_rn(l[x], l[x + 8]);  // offset 8
+#pragma unroll
+                for (int x = 0; x < 4; ++x) l[x] = __fadd_rn(l[x], l[x + 4]);  // offset 4
+#pragma unroll
+                for (int x = 0; x < 2; ++x) l[x] = __fadd_rn(l[x], l[x + 2]);  // offset 2
+                r = __fadd_rn(l[0], l[1]);                                     // offset 1
+            }
+            KQ[(int64_t) h * skq2 + pos] = r;
+        }
+    }
+    __syncthreads();
+    if (stop == 1) return;                                                 // profiling / checking: K.Q only
+
+    soft_max_f32_body<true, 0, 0, T>(KQ, mask, nullptr, SM, p, 0, h, 0, h, data_attn1);
+    __syncthreads();
+    if (stop == 2) return;                                                 // profiling: no V.softmax
+
+    float * buf3 = data_attn1 + GGML_PAD(nkv, WARP_SIZE) + WARP_SIZE;
+    for (int i = tid; i < nd * 8; i += blockDim.x) {
+        buf3[i] = 0.0f;
+    }
+    __syncthreads();
+    const int nvw = bs3 / WARP_SIZE, ncols2 = nkv / 2;
+    const float2 * s2 = (const float2 *) (SM + (int64_t) h * nkv);
+    for (int idx = warp; idx < nd * nvw; idx += blockDim.x / WARP_SIZE) {
+        const int d = idx / nvw, vw = idx % nvw, v = vw * WARP_SIZE + lane;
+        const half2 * x2 = (const half2 *) (V + (int64_t) h * sv2 + (int64_t) d * sv1);
+        half2 sumh2 = make_half2(0.0f, 0.0f);
+        for (int col2 = v; col2 < ncols2; col2 += bs3) {
+            const half2 tmpx = x2[col2];
+            const float2 tmpy = s2[col2];
+            sumh2 += tmpx * make_half2(tmpy.x, tmpy.y);
+        }
+        float sumf = __low2float(sumh2) + __high2float(sumh2);
+        sumf = warp_reduce_sum<WARP_SIZE>(sumf);
+        if (lane == 0) {
+            buf3[d * 8 + vw] = sumf;
+        }
+    }
+    __syncthreads();
+    if (warp < nd) {
+        float sumf = lane < 8 ? buf3[warp * 8 + lane] : 0.0f;
+        sumf = warp_reduce_sum<WARP_SIZE>(sumf);
+        if (lane == 0) {
+            KQV[(int64_t) h * skqv2 + warp] = sumf;
+            if (OUT) OUT[h * nd + warp] = sumf;
+        }
+    }
+}
+
 // TODO: Template to allow keeping ncols in registers if they fit
 static __device__ void soft_max_f32_parallelize_cols_single_row(const float * __restrict__ x,
                                                                 float * __restrict__ dst,
@@ -470,3 +578,108 @@ void ggml_cuda_op_soft_max_back(ggml_backend_cuda_context & ctx, ggml_tensor * d
 
     soft_max_back_f32_cuda(src0_d, src1_d, dst_d, ncols, nrows, scale, stream);
 }
+
+// temporal, TEMPORAL_ATTN1=1: see attn1_f32. kq, sm, kqv, cont are the four nodes it replaces. Returns 0 (nothing
+// launched) unless every one is the case the kernel reproduces; 1 when all four are done; 2 when CONT is left to the
+// caller (its buffer overlaps the softmax's, which other blocks still read). stop: see the kernel (0 = everything).
+int ggml_cuda_attn1(ggml_backend_cuda_context & ctx, ggml_tensor * kq, ggml_tensor * sm, ggml_tensor * kqv, ggml_tensor * cont, int stop) {
+    const ggml_tensor * k = kq->src[0], * q = kq->src[1], * v = kqv->src[0], * mask = sm->src[1];
+    const int cc = ggml_cuda_info().devices[ggml_cuda_get_device()].cc;
+    const int64_t nd = k->ne[0], nkv = k->ne[1], nh = k->ne[2];
+    if (!fast_fp16_available(cc) || k->type != GGML_TYPE_F16 || v->type != GGML_TYPE_F16 || q->type != GGML_TYPE_F32 ||
+        kq->type != GGML_TYPE_F32 || sm->type != GGML_TYPE_F32 || kqv->type != GGML_TYPE_F32 || cont->type != GGML_TYPE_F32) return 0;
+    if (ggml_get_op_params_i32(kq, 0) != GGML_PREC_F32 || ggml_get_op_params_i32(kqv, 0) != GGML_PREC_DEFAULT ||
+        ggml_get_op_params_i32(kq, 1) != 0 || ggml_get_op_params_i32(kqv, 1) != 0) return 0;
+    if (nd % 2 != 0 || nd > 32 || nkv % 2 != 0 || nkv < 256 || nkv > 4096 || k->ne[3] != 1 || v->ne[3] != 1) return 0;
+    if (q->ne[0] != nd || q->ne[1] != 1 || q->ne[2] != nh || q->ne[3] != 1) return 0;
+    if (v->ne[0] != nkv || v->ne[1] != nd || v->ne[2] != nh) return 0;
+    if (kq->ne[0] != nkv || kq->ne[1] != 1 || kq->ne[2] != nh || !ggml_is_contiguous(kq) || !ggml_is_contiguous(sm) || !ggml_are_same_shape(kq, sm)) return 0;
+    if (kqv->ne[0] != nd || kqv->ne[1] != 1 || kqv->ne[2] != nh || ggml_nelements(cont) != nd * nh || !ggml_is_contiguous(cont)) return 0;
+    if (sm->src[0] != kq || sm->src[2] != nullptr || kqv->src[1] != sm) return 0;
+    if (mask && (mask->type != GGML_TYPE_F16 && mask->type != GGML_TYPE_F32)) return 0;
+    // the stock path must be one this reproduces: the vector kernel for V.softmax; for K.Q the vector kernel, or
+    // cuBLAS in float (what ggml_cuda_mul_mat falls through to for F16 K with more than 512 rows) with 16 columns
+    if (!ggml_cuda_should_use_mmvf(v->type, cc, v->ne, v->nb, sm->ne[1])) return 0;
+    int kq_order = 0;
+    if (!ggml_cuda_should_use_mmvf(k->type, cc, k->ne, k->nb, q->ne[1])) {
+        const int warp_size = ggml_cuda_info().devices[ggml_cuda_get_device()].warp_size;
+        if (nd != 16 || getenv("GGML_CUDA_CUBLAS_COMPUTE_TYPE") != nullptr || k->nb[0] != sizeof(half) ||
+            k->nb[1] % (2 * sizeof(half)) != 0 || k->nb[2] % (2 * sizeof(half)) != 0 ||
+            ggml_cuda_should_use_mmf(k->type, cc, warp_size, k->ne, k->nb, q->ne[1], /*mul_mat_id =*/ false)) return 0;
+        kq_order = 1;
+    }
+    // Blocks (heads) run at the same time, so no output may overlap an input another block still reads. The allocator
+    // does reuse Q's buffer for the attention output; that is safe only when the output has Q's layout at Q's address
+    // (a block then overwrites what only it has read). CONT's buffer may be the softmax's: then CONT is left out.
+    bool with_cont = true;
+    {
+        const auto lo = [](const ggml_tensor * t) { return (const char *) t->data; };
+        const auto hi = [](const ggml_tensor * t) { return (const char *) t->data + ggml_nbytes(t); };
+        const auto overlap = [&](const ggml_tensor * a, const ggml_tensor * b) { return lo(a) < hi(b) && lo(b) < hi(a); };
+        const bool q_plain = q->nb[0] == sizeof(float) && (int64_t) q->nb[2] == nd * (int64_t) sizeof(float);
+        if (overlap(cont, kq) || overlap(cont, sm) || (mask && overlap(cont, mask)) || (overlap(cont, q) && !(q_plain && cont->data == q->data)) ||
+            (overlap(cont, kqv) && cont->data != kqv->data)) with_cont = false;
+        for (const ggml_tensor * out : { (const ggml_tensor *) kq, (const ggml_tensor *) sm, (const ggml_tensor *) kqv }) {
+            if (mask && overlap(out, mask)) return 0;
+            if (overlap(out, q) && !(q_plain && out == kqv && out->data == q->data)) return 0;
+        }
+        if (overlap(kq, kqv) || overlap(sm, kqv)) return 0;
+    }
+    for (const ggml_tensor * t : { k, v }) {
+        if (ggml_backend_buffer_get_usage(t->buffer) == GGML_BACKEND_BUFFER_USAGE_COMPUTE &&
+            ggml_nbytes(t) != ggml_backend_buffer_get_alloc_size(t->buffer, t) && t->view_src) return 0;
+    }
+    // block size of the V.softmax launch, as launch_mul_mat_vec_f_cuda chooses it
+    int64_t bs3 = WARP_SIZE, niter_best = (nkv + 2 * WARP_SIZE - 1) / (2 * WARP_SIZE);
+    for (int64_t bs = 2 * WARP_SIZE; bs <= 256; bs += WARP_SIZE) {
+        const int64_t niter = (nkv + 2 * bs - 1) / (2 * bs);
+        if (niter < niter_best) {
+            niter_best = niter;
+            bs3        = bs;
+        }
+    }
+    if (bs3 <= WARP_SIZE) return 0;
+    // K.Q must be the 32-thread kernel
+    for (int64_t bs = 2 * WARP_SIZE; bs <= 256; bs += WARP_SIZE) {
+        if ((nd + 2 * bs - 1) / (2 * bs) < (nd + 2 * WARP_SIZE - 1) / (2 * WARP_SIZE)) return 0;
+    }
+
+    float scale = 1.0f, max_bias = 0.0f;
+    memcpy(&scale,    (const float *) sm->op_params + 0, sizeof(float));
+    memcpy(&max_bias, (const float *) sm->op_params + 1, sizeof(float));
+    const uint32_t n_head      = sm->src[0]->ne[2];
+    const uint32_t n_head_log2 = 1u << (uint32_t) floorf(log2f((float) n_head));
+    soft_max_params params = {};
+    params.nheads = sm->src[0]->ne[2];
+    params.n_head_log2 = n_head_log2;
+    params.ncols = nkv;
+    params.nrows_x = ggml_nrows(sm->src[0]);
+    params.nrows_y = sm->src[0]->ne[1];
+    params.ne00 = sm->src[0]->ne[0];
+    params.ne01 = sm->src[0]->ne[1];
+    params.ne02 = sm->src[0]->ne[2];
+    params.ne03 = sm->src[0]->ne[3];
+    params.nb11 = mask ? mask->nb[1] : 1;
+    params.nb12 = mask ? mask->nb[2] : 1;
+    params.nb13 = mask ? mask->nb[3] : 1;
+    params.ne12 = mask ? mask->ne[2] : 1;
+    params.ne13 = mask ? mask->ne[3] : 1;
+    params.scale = scale;
+    params.max_bias = max_bias;
+    params.m0 = powf(2.0f, -(max_bias       ) / n_head_log2);
+    params.m1 = powf(2.0f, -(max_bias / 2.0f) / n_head_log2);
+
+    const size_t nbytes_shared = (GGML_PAD(nkv, WARP_SIZE) + WARP_SIZE + nd * 8) * sizeof(float);
+    const dim3 block_dims(1024, 1, 1), block_nums(nh, 1, 1);
+    const auto hs = [](const ggml_tensor * t, int d) { return (int) (t->nb[d] / ggml_type_size(t->type)); };
+    if (mask && mask->type == GGML_TYPE_F16) {
+        attn1_f32<half><<<block_nums, block_dims, nbytes_shared, ctx.stream()>>>((const half *) k->data, hs(k, 1), hs(k, 2), (const float *) q->data, hs(q, 2),
+            (float *) kq->data, hs(kq, 2), (const half *) mask->data, (float *) sm->data, params, (const half *) v->data, hs(v, 1), hs(v, 2),
+            (float *) kqv->data, hs(kqv, 2), with_cont ? (float *) cont->data : nullptr, (int) nd, (int) bs3, kq_order, stop);
+    } else {
+        attn1_f32<float><<<block_nums, block_dims, nbytes_shared, ctx.stream()>>>((const half *) k->data, hs(k, 1), hs(k, 2), (const float *) q->data, hs(q, 2),
+            (float *) kq->data, hs(kq, 2), mask ? (const float *) mask->data : nullptr, (float *) sm->data, params, (const half *) v->data, hs(v, 1), hs(v, 2),
+            (float *) kqv->data, hs(kqv, 2), with_cont ? (float *) cont->data : nullptr, (int) nd, (int) bs3, kq_order, stop);
+    }
+    return with_cont ? 1 : 2;
+}
