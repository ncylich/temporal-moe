+// temporal, TEMPORAL_QKV=2: rms_norm * weight of one row, written to dst as rms_norm_f32<block_size, true> writes it,
+// and the same values quantised to Q8_1 as quantize_q8_1 does (a warp holds 32 consecutive columns in both), so the
+// matmuls that follow need no quantise launch. ncols_pad: the padded length quantize_q8_1 would have filled.
+template <int block_size>
+static __global__ void rms_norm_mul_q8_1(const float * x, float * dst, const int ncols, const float eps, const float * mul,
+                                         block_q8_1 * y, const int ncols_pad) {
+    ggml_cuda_pdl_lc();
+    const int tid = threadIdx.x;
+    float tmp = 0.0f; // partial sum for thread in warp
+
+    ggml_cuda_pdl_sync();
+    for (int col = tid; col < ncols; col += block_size) {
+        const float xi = x[col];
+        tmp += xi * xi;
+    }
+
+    extern __shared__ float s_sum[];
+    tmp = block_reduce<block_reduce_method::SUM, block_size>(tmp, s_sum);
+
+    const float mean = tmp / ncols;
+    const float scale = rsqrtf(mean + eps);
+
+    for (int col = tid; col < ncols_pad; col += block_size) {
+        float xi = 0.0f;
+        if (col < ncols) {
+            dst[col] = scale * x[col] * mul[col];
+            xi = dst[col];
+        }
+        float amax = fabsf(xi);
+        float sum = xi;
+
+        amax = warp_reduce_max<QK8_1>(amax);
+        sum  = warp_reduce_sum<QK8_1>(sum);
+
+        const float  d = amax / 127.0f;
+        const int8_t q = amax == 0.0f ? 0 : roundf(xi / d);
+
+        y[col / QK8_1].qs[col % QK8_1] = q;
+        if (col % QK8_1 == 0) {
+            y[col / QK8_1].ds = make_half2(d, sum);
+        }
+    }
+}
+
+void ggml_cuda_rms_norm_mul_q8_1(ggml_backend_cuda_context & ctx, const ggml_tensor * norm, const ggml_tensor * mul_tensor,
+                                 void * vy, int64_t ncols_pad) {
+    const ggml_tensor * src = norm->src[0];
+    const ggml_tensor * w   = mul_tensor->src[0] == norm ? mul_tensor->src[1] : mul_tensor->src[0];
+    float eps = 0.0f;
+    memcpy(&eps, norm->op_params, sizeof(float));
+    const int ncols = (int) src->ne[0];
+    GGML_ASSERT(src->type == GGML_TYPE_F32 && w->type == GGML_TYPE_F32 && mul_tensor->type == GGML_TYPE_F32);
+    GGML_ASSERT(ggml_nelements(src) == ncols && ggml_nelements(w) == ncols && ncols % QK8_1 == 0 && ncols_pad % QK8_1 == 0);
+    const dim3 blocks_num(1, 1, 1);
+    // same block size as rms_norm_mul_f32_cuda picks, so the sum of squares is reduced in the same order
+    if (ncols < 1024) {
+        const dim3 block_dims(256, 1, 1);
+        const ggml_cuda_kernel_launch_params launch_params = ggml_cuda_kernel_launch_params{blocks_num, block_dims, 32 * sizeof(float), ctx.stream()};
+        ggml_cuda_kernel_launch(rms_norm_mul_q8_1<256>, launch_params, (const float *) src->data, (float *) mul_tensor->data, ncols, eps,
+                                (const float *) w->data, (block_q8_1 *) vy, (int) ncols_pad);
+    } else {
+        GGML_ASSERT(ncols == 1024 && ncols_pad == 1024);
+        const dim3 block_dims(1024, 1, 1);
+        const ggml_cuda_kernel_launch_params launch_params = ggml_cuda_kernel_launch_params{blocks_num, block_dims, 32 * sizeof(float), ctx.stream()};
+        ggml_cuda_kernel_launch(rms_norm_mul_q8_1<1024>, launch_params, (const float *) src->data, (float *) mul_tensor->data, ncols, eps,
+                                (const float *) w->data, (block_q8_1 *) vy, (int) ncols_pad);
+    }
+}
