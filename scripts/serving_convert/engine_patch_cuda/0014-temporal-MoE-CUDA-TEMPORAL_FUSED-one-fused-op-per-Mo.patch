@@ -1192,3 +1197,174 @@ void ggml_cuda_temporal_route_reset() {
     }
     CUDA_CHECK(cudaMemset(g_tr_k, 0, TR_MAXLAYER*sizeof(int)));
 }
+
+// ===== TEMPORAL_FUSED: the MoE layer after the gate weights, as three launches =====
+// Replaces, for one token: the shared expert (gate, up, SwiGLU, down), the routed experts (gate, up, SwiGLU,
+// down), experts * weights, the sum over experts and + shared. Same model, same Q4_0 weights, same slots. The
+// selected experts, the swap list and the gate weights are inputs, written by the engine's own router,
+// softmax, routing op and gate-weight ops earlier in the graph; nothing here knows a load before they ran.
+//   A   gate and up products of every routed expert and of the shared expert: one block per 32 rows of one
+//       tensor, one warp per row, one lane per Q4_0 block. Each block quantises the layer input itself (Q8_1,
+//       as mul_mat_vec_q's input). The blocks of an expert being loaded first move their part of the gate or
+//       up tensor from the host-mapped pool into the slot, one 16-byte read per thread, then compute from it.
+//   A2  SwiGLU and Q8_1 quantisation of the activations.
+//   B   down products, experts * gate weights, sum over experts in selection order, + shared: one block per
+//       output row. The down row of an expert being loaded is moved from the pool by extra threads of the same
+//       block while the other experts' products are computed; its own products follow.
+// Dot products use llama.cpp's Q4_0 x Q8_1 integer arithmetic but one 32-weight block per thread and float
+// (not half) activation scales, so sums are formed in a different order from mul_mat_vec_q: results agree
+// with the unfused path to rounding, not bit for bit. Streamed and all-in-VRAM run the same code and are
+// bit-identical to each other.
+struct __attribute__((packed)) tf_q4 { uint16_t d; uint8_t qs[16]; };
+struct tf_q8 { float d; float s; int8_t qs[32]; };                         // s = d * sum(qs)
+static __device__ inline int tf_load4(const uint8_t * p) { int v; memcpy(&v, p, 4); return v; }
+static __device__ inline float tf_dot(const tf_q4 * w, const tf_q8 * x) {
+    int sumi = 0;
+#pragma unroll
+    for (int i = 0; i < 4; ++i) {
+        const int v = tf_load4(w->qs + 4*i);
+        sumi = __dp4a(v & 0x0F0F0F0F, tf_load4((const uint8_t *) x->qs + 4*i), sumi);
+        sumi = __dp4a((v >> 4) & 0x0F0F0F0F, tf_load4((const uint8_t *) x->qs + 16 + 4*i), sumi);
+    }
+    return __half2float(__ushort_as_half(w->d)) * (x->d * (float) sumi - 8.0f * x->s);
+}
+static __device__ inline void tf_quant(const float * x, tf_q8 * q) {
+    float amax = 0.0f;
+    for (int i = 0; i < 32; ++i) amax = fmaxf(amax, fabsf(x[i]));
+    const float d = amax / 127.0f, id = d ? 1.0f / d : 0.0f; int sum = 0;
+    for (int i = 0; i < 32; ++i) { const int v = (int) roundf(x[i] * id); q->qs[i] = (int8_t) v; sum += v; }
+    q->d = d; q->s = d * (float) sum;
+}
+static __device__ inline float tf_wsum(float a) {
+#pragma unroll
+    for (int o = 16; o > 0; o >>= 1) a += __shfl_xor_sync(0xFFFFFFFFu, a, o);
+    return a;
+}
+struct TFA {
+    const float * x;
+    const uint8_t * W[3]; const int * ids; const uint8_t * pool[3];        // gate, up, (down unused here)
+    const int * swp_e, * swp_s, * nswp;
+    const uint8_t * SG, * SU;
+    float * gu, * sg, * su;
+    size_t be; int D, F, FS, K;
+};
+__global__ void k_tf_a(TFA A) {
+    __shared__ tf_q8 xq[28]; __shared__ float xs[896];
+    const int lane = threadIdx.x & 31, row = threadIdx.x >> 5, blk = blockIdx.x;
+    const int DB = A.D / 32, GR = A.F / 32, NR = A.K * GR * 2;
+    for (int i = threadIdx.x; i < A.D; i += 1024) xs[i] = A.x[i];
+    __syncthreads();
+    if (threadIdx.x < DB) tf_quant(xs + 32 * threadIdx.x, xq + threadIdx.x);
+    __syncthreads();
+    if (blk >= NR) {                                                       // shared expert: gate or up, 32 rows
+        const int sb = blk - NR, w = sb & 1, r = (sb >> 1) * 32 + row; float a = 0.0f;
+        if (lane < DB) { const tf_q4 q = ((const tf_q4 *) (w ? A.SU : A.SG))[(size_t) r * DB + lane]; a = tf_dot(&q, xq + lane); }
+        a = tf_wsum(a); if (lane == 0) (w ? A.su : A.sg)[r] = a;
+        return;
+    }
+    const int w = blk % 2, g = (blk / 2) % GR, c = blk / (2 * GR), slot = A.ids[c];
+    if (A.pool[0]) {                                                       // streamed: is this position's expert being loaded?
+        int e = -1; const int ns = min(*A.nswp, A.K);
+        for (int k = 0; k < ns; ++k) if (A.swp_s[k] == slot) e = A.swp_e[k];
+        if (e >= 0) {
+            const int NV = (int) (A.be / 16 / GR);
+            if ((int) threadIdx.x < NV) {
+                const size_t o = (size_t) g * NV + threadIdx.x;
+                ((uint4 *) A.W[w])[(size_t) slot * (A.be / 16) + o] = ((const uint4 *) A.pool[w])[(size_t) e * (A.be / 16) + o];
+            }
+            __syncthreads();
+        }
+    }
+    const int r = g * 32 + row; float a = 0.0f;
+    if (lane < DB) { const tf_q4 q = ((const tf_q4 *) A.W[w])[(size_t) slot * (A.be / 18) + (size_t) r * DB + lane]; a = tf_dot(&q, xq + lane); }
+    a = tf_wsum(a);
+    if (lane == 0) A.gu[((size_t) w * A.K + c) * A.F + r] = a;
+}
+__global__ void k_tf_a2(const float * __restrict__ gu, const float * __restrict__ sg, const float * __restrict__ su, tf_q8 * __restrict__ aq, int nrouted, int KF) {
+    __shared__ float act[32];
+    const int q = blockIdx.x, i = threadIdx.x;
+    float g, u;
+    if (q < nrouted) { g = gu[(size_t) q * 32 + i]; u = gu[(size_t) KF + (size_t) q * 32 + i]; }
+    else             { g = sg[(q - nrouted) * 32 + i]; u = su[(q - nrouted) * 32 + i]; }
+    act[i] = g / (1.0f + expf(-g)) * u;
+    __syncthreads();
+    if (i == 0) tf_quant(act, aq + q);
+}
+struct TFB {
+    const tf_q8 * aq; const float * wgt;
+    const uint8_t * Dn; const int * ids; const uint8_t * poolD;
+    const int * swp_e, * swp_s, * nswp;
+    const uint8_t * SD;
+    float * y;
+    size_t be; int D, F, FS, K;
+};
+__global__ void k_tf_b(TFB B) {                                            // one block per output row; 128 compute + 32 copy threads
+    __shared__ float v[128]; __shared__ float part[65];
+    const int i = threadIdx.x, r = blockIdx.x, GR = B.F / 32, NRQ = B.K * GR, NQ = NRQ + B.FS / 32, RB = GR * 18;
+    const int ns = B.poolD ? min(*B.nswp, B.K) : 0;
+    float a = 0.0f; bool late = false; int slot = 0, b = 0;
+    if (i < NRQ) {
+        b = i % GR; slot = B.ids[i / GR];
+        for (int k = 0; k < ns; ++k) late |= B.swp_s[k] == slot;
+        if (!late) { const tf_q4 w = ((const tf_q4 *) B.Dn)[(size_t) slot * (B.be / 18) + (size_t) r * GR + b]; a = tf_dot(&w, B.aq + i); }
+    } else if (i < NQ) {
+        const tf_q4 w = ((const tf_q4 *) B.SD)[(size_t) r * (B.FS / 32) + (i - NRQ)];
+        a = tf_dot(&w, B.aq + i);
+    } else if (i >= 128) {
+        // the 16-byte vectors covering row r of each loaded expert's down tensor, pool -> slot, one read per
+        // thread; vectors on a row boundary are written by both neighbouring rows with the same bytes
+        const int j = i - 128, vi = j % 8;
+        const size_t first = (size_t) r * RB / 16, last = ((size_t) r * RB + RB - 1) / 16;
+        for (int k = j / 8; k < ns; k += 4)
+            if (first + vi <= last) ((uint4 *) B.Dn)[(size_t) B.swp_s[k] * (B.be / 16) + first + vi] = ((const uint4 *) B.poolD)[(size_t) B.swp_e[k] * (B.be / 16) + first + vi];
+    }
+    __syncthreads();
+    if (late) { const tf_q4 w = ((const tf_q4 *) B.Dn)[(size_t) slot * (B.be / 18) + (size_t) r * GR + b]; a = tf_dot(&w, B.aq + i); }
+    if (i < 128) v[i] = a;
+    __syncthreads();
+    if (i < B.K) { float p = 0.0f; for (int q = 0; q < GR; ++q) p += v[i * GR + q]; part[i] = p; }
+    else if (i == B.K) { float p = 0.0f; for (int q = NRQ; q < NQ; ++q) p += v[q]; part[B.K] = p; }
+    __syncthreads();
+    if (i == 0) {
+        float s2 = part[0] * B.wgt[0];
+        for (int c = 1; c < B.K; ++c) s2 += part[c] * B.wgt[c];
+        B.y[r] = s2 + part[B.K];
+    }
+}
+bool ggml_cuda_temporal_fused_op(const ggml_tensor * t) {
+    return ggml_cuda_temporal_fused_on() && ggml_cuda_temporal_route_op_on() && strncmp(t->name, "ffn_moe_fused", 13) == 0 && t->type == GGML_TYPE_F32;
+}
+void ggml_cuda_temporal_fused(cudaStream_t stream, ggml_tensor * dst) {
+    const ggml_tensor * x = dst->src[0], * ids = dst->src[1], * wgt = dst->src[2];
+    const ggml_tensor * W[3] = { dst->src[3], dst->src[4], dst->src[5] }, * Sx[3] = { dst->src[6], dst->src[7], dst->src[8] };
+    const int D = (int) x->ne[0], F = (int) W[0]->ne[1], FS = (int) Sx[0]->ne[1], K = (int) ids->ne[0], GR = F / 32;
+    GGML_ASSERT(x->ne[1] == 1 && D % 32 == 0 && D <= 896 && F % 32 == 0 && F <= 192 && FS % 32 == 0 && K * GR + FS / 32 <= 128 && K <= 64);
+    static float * gu = nullptr, * sg = nullptr, * su = nullptr; static tf_q8 * aq = nullptr; static int cap = 0;
+    if (!gu) {
+        CUDA_CHECK(cudaMalloc(&gu, (size_t) 2 * 64 * 192 * sizeof(float))); CUDA_CHECK(cudaMalloc(&sg, 4096 * sizeof(float))); CUDA_CHECK(cudaMalloc(&su, 4096 * sizeof(float)));
+        CUDA_CHECK(cudaMalloc(&aq, 128 * sizeof(tf_q8))); cap = 1;
+        fprintf(stderr, "[temporal-fused] one fused op per MoE layer on single-token steps: D=%d F=%d FS=%d K=%d\n", D, F, FS, K);
+    }
+    GGML_ASSERT(FS <= 4096);
+    TFA A; memset(&A, 0, sizeof A); TFB B; memset(&B, 0, sizeof B);
+    auto it = g_tptr.find(W[0]->data);
+    if (it != g_tptr.end()) {                                              // streamed: slots, pool, the routing op's swap list
+        TU & L = g_L[it->second.first];
+        GGML_ASSERT(L.remap_ids && L.R == K && (L.be[0] / 16) % GR == 0 && L.be[0] / 16 / GR <= 1024 && L.be[0] == L.be[1] && L.be[0] == L.be[2]);
+        for (int w = 0; w < 3; ++w) { A.W[w] = L.slot[w]; A.pool[w] = L.pool_dev[w]; }
+        A.ids = L.remap_ids; A.swp_e = L.d_swp_e; A.swp_s = L.d_swp_s; A.nswp = L.d_nswp; A.be = L.be[0];
+        B.poolD = L.pool_dev[2];
+    } else {                                                               // all in VRAM: the full tables, expert ids
+        for (int w = 0; w < 3; ++w) A.W[w] = (const uint8_t *) W[w]->data;
+        A.ids = (const int *) ids->data; A.be = W[0]->nb[2];
+    }
+    A.x = (const float *) x->data; A.SG = (const uint8_t *) Sx[0]->data; A.SU = (const uint8_t *) Sx[1]->data;
+    A.gu = gu; A.sg = sg; A.su = su; A.D = D; A.F = F; A.FS = FS; A.K = K;
+    k_tf_a<<<K * GR * 2 + (FS / 32) * 2, 1024, 0, stream>>>(A);
+    k_tf_a2<<<K * GR + FS / 32, 32, 0, stream>>>(gu, sg, su, aq, K * GR, K * F);
+    B.aq = aq; B.wgt = (const float *) wgt->data; B.Dn = A.W[2]; B.ids = A.ids; B.swp_e = A.swp_e; B.swp_s = A.swp_s; B.nswp = A.nswp;
+    B.SD = (const uint8_t *) Sx[2]->data; B.y = (float *) dst->data; B.be = A.be; B.D = D; B.F = F; B.FS = FS; B.K = K;
+    k_tf_b<<<D, 160, 0, stream>>>(B);
+    CUDA_CHECK(cudaGetLastError());
+    (void) cap;
+}
