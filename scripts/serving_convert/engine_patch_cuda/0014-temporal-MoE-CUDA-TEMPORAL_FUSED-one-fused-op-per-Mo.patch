@@ -990,6 +999,14 @@ __global__ void k_skliar(const float * __restrict__ lg, int E, int K, float lam,
     }
 }
 
+// TEMPORAL_ROUTE_STUB=1 (profiling, output wrong): single-token routing kernels are replaced by a launch that
+// selects experts 0..K-1 with no load, so the token time shows what the routing kernel costs beyond a launch
+static int tr_stub() { static int v=[](){const char*s=getenv("TEMPORAL_ROUTE_STUB");return s?atoi(s):0;}(); return v; }
+__global__ void k_route_stub(int32_t * out, int K, int * nswp, int32_t * remap) {
+    const int j = threadIdx.x;
+    if (j < K) { out[j] = j; if (remap) remap[j] = j; }
+    if (j == 0 && nswp) *nswp = 0;
+}
 static void tr2_report() {
     if (!g2.ready) return;
     const int H = g2.K + 1;
@@ -1072,6 +1089,8 @@ static void tr2_route(cudaStream_t stream, ggml_tensor * dst, int L, int K, int
     if (g2.dump && g2.ntokl < n_tokens) { if (g2.tokl) cudaFree(g2.tokl); CUDA_CHECK(cudaMalloc(&g2.tokl, n_tokens*sizeof(int))); g2.ntokl = n_tokens; }
     // TEMPORAL_CB_K2=1 keeps single skliar tokens on k_route2
     static const bool sk_k2 = getenv("TEMPORAL_CB_K2") && atoi(getenv("TEMPORAL_CB_K2"));
+    if (tr_stub() && n_tokens == 1) k_route_stub<<<1, 64, 0, stream>>>((int32_t *) dst->data, K, sl ? T->d_nswp : nullptr, sl ? T->remap_ids : nullptr);
+    else
     if (mode == 3 && n_tokens == 1 && g2.C == K && !tr2_fullsel() && !sk_k2)
     k_skliar<<<1, 256, (size_t) 2*E*sizeof(int), stream>>>((const float *) lg->data, E, K, g2.lam, g2.J, g2.st + L,
             g2.win + (size_t) L*K, g2.tnow + L, g2.dsum + L, g2.dn + L, g2.hist + (size_t) L*(K+1), g2.cnt + (size_t) L*4,
@@ -1089,7 +1108,7 @@ static void tr2_route(cudaStream_t stream, ggml_tensor * dst, int L, int K, int
     if (sl && tr_slots() == 2 && n_tokens == 1 && (tu_swap_n() >= 0 || tu_swap_hist() > 0))
         k_force_route<<<1, K, 0, stream>>>(T->d_swp_e, T->d_swp_s, T->d_nswp, tu_swap_n(), E, K, T->remap_ids, T->split_ids,
                                            tu_swap_hist() > 0 ? g_hist_cum : nullptr, g_hist_n);
-    if (sl && tr_slots() == 2 && n_tokens == 1 && tr_nocopy() != 2) {   // copies start at the router; =1 leaves them to the expert op
+    if (sl && tr_slots() == 2 && n_tokens == 1 && tr_nocopy() != 2 && ggml_cuda_temporal_fused_on() != 1) {   // copies start at the router; =1 leaves them to the expert op
         cudaEventRecord(T->fork, stream);
         cudaStreamWaitEvent(g_copy, T->fork, 0);
         for (int w = 0; w < 3; ++w) {
@@ -1141,6 +1160,8 @@ void ggml_cuda_temporal_route(cudaStream_t stream, ggml_tensor * dst) {
         CUDA_CHECK(cudaMalloc(&T->remap_ids, K*sizeof(int32_t))); T->remap_words = K;
     }
     if (sl && !T->split_ids && ggml_cuda_temporal_load_first()) CUDA_CHECK(cudaMalloc(&T->split_ids, 2*K*sizeof(int32_t)));
+    if (tr_stub() && n_tokens == 1) k_route_stub<<<1, 64, 0, stream>>>((int32_t *) dst->data, K, sl ? T->d_nswp : nullptr, sl ? T->remap_ids : nullptr);
+    else
     k_route<<<1, 256, (size_t)2*E*sizeof(int), stream>>>((const float *) lg->data, lg->nb[1]/sizeof(float), n_tokens, E, K,
             g_tr_k + L, g_tr_win + (size_t)L*K, g_tr_cnt + (size_t)L*3, (int32_t *) dst->data,
             sl ? g_tr_vslot + (size_t)L*K : nullptr, g_tr_vvalid + L, sl ? T->d_swp_e : nullptr, sl ? T->d_swp_s : nullptr,
@@ -1153,7 +1174,7 @@ void ggml_cuda_temporal_route(cudaStream_t stream, ggml_tensor * dst) {
     // TEMPORAL_ROUTE_SLOTS=2: the swap list exists now, so start the copies here instead of at the gate
     // GEMM. They run on the copy stream under whatever the graph has between the router and the routed
     // experts (gate weights, and the shared expert when the graph puts it first).
-    if (sl && tr_slots() == 2 && n_tokens == 1) {
+    if (sl && tr_slots() == 2 && n_tokens == 1 && ggml_cuda_temporal_fused_on() != 1) {
         cudaEventRecord(T->fork, stream);
         cudaStreamWaitEvent(g_copy, T->fork, 0);
         for (int w = 0; w < 3; ++w) {
@@ -1192,3 +1213,245 @@ void ggml_cuda_temporal_route_reset() {
     }
     CUDA_CHECK(cudaMemset(g_tr_k, 0, TR_MAXLAYER*sizeof(int)));
 }
+
+// ===== TEMPORAL_FUSED: the MoE layer after the gate weights, as two launches =====
+// Replaces, for one token: the shared expert (gate, up, SwiGLU, down), the routed experts (gate, up, SwiGLU,
+// down), experts * weights, the sum over experts and + shared. Same model, same Q4_0 weights, same slots. The
+// selected experts, the swap list and the gate weights are inputs, written by the engine's own router,
+// softmax, routing op and gate-weight ops earlier in the graph; nothing here knows a load before they ran.
+//   A   gate and up products, SwiGLU and Q8_1 activations of every routed expert and of the shared expert: one
+//       block per 32 rows of an expert, one warp per row. Each block quantises the layer input itself (Q8_1,
+//       as mul_mat_vec_q's input). The blocks of an expert being loaded come first in the grid and first move
+//       their part of the gate and up tensors from the host-mapped pool into the slot, then compute from it.
+//   B   down products, experts * gate weights, sum over experts in selection order, + shared: one block per
+//       output row. The down row of an expert being loaded is moved from the pool by extra threads of the same
+//       block while the other experts' products are computed; its own products follow.
+// Arithmetic is the unfused path's, operation for operation: the input and the activations are quantised as
+// quantize_q8_1 does (scale and sum stored as halves), every product is vec_dot_q4_0_q8_1 on half a Q4_0
+// block, and each row's partial sums are added in mul_mat_vec_q's order for this card (thread t = 32y + x takes
+// block t/2, half t%2; lane x adds its y = 0, 1, 2 values in that order; then the xor-shuffle reduction over
+// the 32 lanes). SwiGLU is up * silu(gate), experts * weights are summed in selection order, then + shared.
+// The result is bit-identical to the unfused path (gate: batch-1 perplexity equal in every digit).
+#include "vecdotq.cuh"
+#include "unary.cuh"
+static __device__ __forceinline__ void tf_quant_lane(float xi, block_q8_1 * q) {      // one warp = one Q8_1 block, as quantize_q8_1
+    const int lane = threadIdx.x & 31;
+    float amax = fabsf(xi), sum = xi;
+    amax = warp_reduce_max<QK8_1>(amax);
+    sum  = warp_reduce_sum<QK8_1>(sum);
+    const float  d = amax / 127.0f;
+    const int8_t v = amax == 0.0f ? 0 : roundf(xi / d);
+    q->qs[lane] = v;
+    if (lane == 0) q->ds = make_half2(d, sum);
+}
+// one row of nblk Q4_0 blocks times nblk Q8_1 blocks; called by all 32 lanes of a warp; nblk <= 32.
+// In mul_mat_vec_q lane x adds half x%2 of block x/2 and half x%2 of block 16 + x/2. Here each lane reads one
+// whole block (even lanes block x/2, odd lanes block 16 + x/2), computes both halves, and the pair swaps the
+// half the other lane needs with one shuffle: the same values added in the same order, half the block reads.
+static __device__ __forceinline__ float tf_row(const void * W, int kbx0, const block_q8_1 * y, int nblk) {
+    const int x = threadIdx.x & 31, kb = (x & 1) ? 16 + (x >> 1) : (x >> 1);
+    float h0 = 0.0f, h1 = 0.0f;
+    if (kb < nblk) { h0 = vec_dot_q4_0_q8_1(W, y + kb, kbx0 + kb, 0); h1 = vec_dot_q4_0_q8_1(W, y + kb, kbx0 + kb, 2); }
+    // even lane keeps its half 0 and needs the odd lane's half 0; odd lane keeps its half 1 and needs the even lane's
+    const float other = __shfl_xor_sync(0xFFFFFFFFu, (x & 1) ? h0 : h1, 1);
+    const float a = (x & 1) ? __fadd_rn(other, h1) : __fadd_rn(h0, other);
+    return warp_reduce_sum(a);
+}
+struct TFA {
+    const float * x;
+    const uint8_t * W[3]; const int * ids; const uint8_t * pool[3];        // gate, up, (down unused here)
+    const int * swp_e, * swp_s, * nswp;
+    const uint8_t * SG, * SU;
+    block_q8_1 * aq;
+    size_t be; int D, F, FS, K;
+    const float * lg; const int * eids; float * wgt; int E, normw;        // gate weights from the router logits (lg null: not here)
+    int pass;       // -1: every position, loading ones copied here; 0: positions not being loaded; 1: only those being loaded
+};
+// One block per 32 rows of one expert: gate rows, up rows, SwiGLU, and the Q8_1 block of those 32 activations.
+// Routed positions are taken in the order "experts being loaded first", so their blocks are scheduled first
+// and their reads start with the launch.
+__global__ void k_tf_a(TFA A) {
+    __shared__ block_q8_1 xq[32]; __shared__ float act[32]; __shared__ int s_c, s_e;
+    const int lane = threadIdx.x & 31, row = threadIdx.x >> 5, blk = blockIdx.x;
+    const int DB = A.D / 32, GR = A.F / 32, NR = A.K * GR;
+    if (A.lg && blk == NR + A.FS / 32) {
+        // the gate weights: softmax over the E router logits, gathered at the selected experts, and (normw) divided
+        // by their clamped sum. Same operations and the same summation order as the soft_max (block of 256 threads),
+        // get_rows, sum_rows (first warp holds the K values), clamp and div kernels this replaces.
+        __shared__ float ev[256]; __shared__ float sv[8]; __shared__ float s_m;
+        const int t = threadIdx.x;
+        if (t < 256) ev[t] = t < A.E ? A.lg[t] : -INFINITY;
+        __syncthreads();
+        if (t == 0) { float m = -INFINITY; for (int i = 0; i < A.E; ++i) m = max(m, ev[i]); s_m = m; }
+        __syncthreads();
+        float e = 0.0f;
+        if (t < 256) {
+            if (t < A.E) e = expf(ev[t] - s_m);
+            const float ws = warp_reduce_sum(e);
+            if (lane == 0) sv[row] = ws;
+        }
+        __syncthreads();
+        if (t < 256) ev[t] = e;
+        if (t < 32) { const float tot = warp_reduce_sum(lane < 8 ? sv[lane] : 0.0f); if (t == 0) s_m = tot; }
+        __syncthreads();
+        if (t < 32) {
+            const float inv_sum = 1.0f / s_m;
+            float p = lane < A.K ? ev[A.eids[lane]] * inv_sum : 0.0f;
+            if (A.normw) {
+                float sum = warp_reduce_sum(p);
+                sum = sum < 6.103515625e-5f ? 6.103515625e-5f : sum;
+                p = p / sum;
+            }
+            if (lane < A.K) A.wgt[lane] = p;
+        }
+        return;
+    }
+    if (row < DB) tf_quant_lane(A.x[32 * row + lane], xq + row);
+    if (threadIdx.x == 1023 && blk < NR) {                                 // which position this block computes, and its load
+        const int p = blk / GR, ns = A.pool[0] ? min(*A.nswp, A.K) : 0;
+        int c = -1, e = -1, k = 0;
+        for (int j = 0; j < A.K && ns; ++j) {
+            int m = -1; for (int q = 0; q < ns; ++q) if (A.swp_s[q] == A.ids[j]) m = q;
+            if (m >= 0) { if (k == p) { c = j; e = A.swp_e[m]; } k++; }
+        }
+        if (c < 0) for (int j = 0; j < A.K; ++j) {
+            bool inc = false; for (int q = 0; q < ns; ++q) inc |= A.swp_s[q] == A.ids[j];
+            if (!inc) { if (k == p) c = j; k++; }
+        }
+        s_c = c; s_e = e;
+    }
+    __syncthreads();
+    const void * G, * U; int kb0, q;
+    if (blk >= NR) {                                                       // shared expert, rows 32*g .. 32*g+31
+        if (A.pass == 1) return;
+        const int g = blk - NR;
+        G = A.SG; U = A.SU; kb0 = (g * 32 + row) * DB; q = NR + g;
+    } else {
+        const int g = blk % GR, c = s_c, slot = A.ids[c];
+        if (A.pass == 0 && s_e >= 0) return;                               // computed by the second launch, after its copies
+        if (A.pass == 1 && s_e < 0) return;
+        if (A.pass < 0 && s_e >= 0) {                                      // host pool -> slot: this block's part of gate and of up
+            const int NV = (int) (A.be / 16 / GR);
+            if ((int) threadIdx.x < NV) {
+                const size_t so = (size_t) slot * (A.be / 16) + (size_t) g * NV + threadIdx.x, eo = (size_t) s_e * (A.be / 16) + (size_t) g * NV + threadIdx.x;
+                const uint4 vg = ((const uint4 *) A.pool[0])[eo], vu = ((const uint4 *) A.pool[1])[eo];
+                ((uint4 *) A.W[0])[so] = vg; ((uint4 *) A.W[1])[so] = vu;
+            }
+            __syncthreads();
+        }
+        G = A.W[0]; U = A.W[1]; kb0 = slot * (int) (A.be / sizeof(block_q4_0)) + (g * 32 + row) * DB; q = c * GR + g;
+    }
+    const float gv = tf_row(G, kb0, xq, DB), uv = tf_row(U, kb0, xq, DB);
+    if (lane == 0) act[row] = uv * ggml_cuda_op_silu_single(gv);
+    __syncthreads();
+    if (row == 0) tf_quant_lane(act[lane], A.aq + q);
+}
+struct TFB {
+    const block_q8_1 * aq; const float * wgt;
+    const uint8_t * Dn; const int * ids; const uint8_t * poolD;
+    const int * swp_e, * swp_s, * nswp;
+    const uint8_t * SD;
+    float * y;
+    size_t be; int D, F, FS, K;
+};
+constexpr int TFB_C = 160, TFB_T = 160;                                    // most compute threads; threads per block (the ones past the
+                                                                           // compute threads move loaded experts' rows, 8 per expert)
+static __device__ float tf_tree(float * l) {                               // the 32-lane xor-shuffle reduction, done by one thread
+    for (int o = 16; o > 0; o >>= 1) for (int x = 0; x < 32; ++x) if (!(x & o)) l[x] = __fadd_rn(l[x], l[x ^ o]);
+    return l[0];
+}
+__global__ void k_tf_b(TFB B) {                                            // one block per output row, one thread per Q4_0 block
+    __shared__ float v[2 * TFB_C]; __shared__ float part[65];
+    const int i = threadIdx.x, r = blockIdx.x, GR = B.F / 32, SB = B.FS / 32, NRQ = B.K * GR, NQ = NRQ + SB, RB = GR * 18;
+    const int ns = B.poolD ? min(*B.nswp, B.K) : 0;
+    const int q4pe = (int) (B.be / sizeof(block_q4_0));
+    float a0 = 0.0f, a1 = 0.0f; bool late = false; int slot = 0, b = 0;
+    if (i < NRQ) {
+        b = i % GR; slot = B.ids[i / GR];
+        for (int k = 0; k < ns; ++k) late |= B.swp_s[k] == slot;
+        if (!late) { a0 = vec_dot_q4_0_q8_1(B.Dn, B.aq + i, slot * q4pe + r * GR + b, 0); a1 = vec_dot_q4_0_q8_1(B.Dn, B.aq + i, slot * q4pe + r * GR + b, 2); }
+    } else if (i < NQ) {
+        a0 = vec_dot_q4_0_q8_1(B.SD, B.aq + i, r * SB + (i - NRQ), 0); a1 = vec_dot_q4_0_q8_1(B.SD, B.aq + i, r * SB + (i - NRQ), 2);
+    } else if (i - NQ < 8 * ((TFB_T - NQ) / 8)) {
+        // the 16-byte vectors covering row r of each loaded expert's down tensor, pool -> slot, one read per
+        // thread; vectors on a row boundary are written by both neighbouring rows with the same bytes
+        const int j = i - NQ, vi = j % 8, ncp = (TFB_T - NQ) / 8;
+        const size_t first = (size_t) r * RB / 16, last = ((size_t) r * RB + RB - 1) / 16;
+        for (int k = j / 8; k < ns; k += ncp)
+            if (first + vi <= last) ((uint4 *) B.Dn)[(size_t) B.swp_s[k] * (B.be / 16) + first + vi] = ((const uint4 *) B.poolD)[(size_t) B.swp_e[k] * (B.be / 16) + first + vi];
+    }
+    __syncthreads();
+    if (late) { a0 = vec_dot_q4_0_q8_1(B.Dn, B.aq + i, slot * q4pe + r * GR + b, 0); a1 = vec_dot_q4_0_q8_1(B.Dn, B.aq + i, slot * q4pe + r * GR + b, 2); }
+    if (i < NQ) { v[2 * i] = a0; v[2 * i + 1] = a1; }
+    __syncthreads();
+    if (i <= B.K) {                                                        // thread c sums expert c's row; thread K the shared expert's
+        float l[32];
+        const float * src = v + (i < B.K ? 2 * i * GR : 2 * NRQ); const int n = 2 * (i < B.K ? GR : SB);
+        for (int x = 0; x < 32; ++x) {
+            float t = x < n ? src[x] : 0.0f;
+            if (32 + x < n) t = __fadd_rn(t, src[32 + x]);
+            if (64 + x < n) t = __fadd_rn(t, src[64 + x]);
+            l[x] = t;
+        }
+        part[i] = tf_tree(l);
+    }
+    __syncthreads();
+    if (i == 0) {
+        float s2 = __fmul_rn(part[0], B.wgt[0]);
+        for (int c = 1; c < B.K; ++c) s2 = __fadd_rn(s2, __fmul_rn(part[c], B.wgt[c]));
+        B.y[r] = __fadd_rn(s2, part[B.K]);
+    }
+}
+bool ggml_cuda_temporal_fused_op(const ggml_tensor * t) {
+    // recognised by its inputs, not its name (the model code renames the node): nine sources, the fourth a Q4_0 table
+    return ggml_cuda_temporal_fused_on() && ggml_cuda_temporal_route_op_on() && t->type == GGML_TYPE_F32
+        && t->src[8] && t->src[3] && t->src[3]->type == GGML_TYPE_Q4_0 && t->src[1] && t->src[1]->type == GGML_TYPE_I32;
+}
+void ggml_cuda_temporal_fused(cudaStream_t stream, ggml_tensor * dst) {
+    const ggml_tensor * x = dst->src[0], * ids = dst->src[1], * wgt = dst->src[2];
+    const ggml_tensor * W[3] = { dst->src[3], dst->src[4], dst->src[5] }, * Sx[3] = { dst->src[6], dst->src[7], dst->src[8] };
+    const int D = (int) x->ne[0], F = (int) W[0]->ne[1], FS = (int) Sx[0]->ne[1], K = (int) ids->ne[0], GR = F / 32;
+    GGML_ASSERT(x->ne[1] == 1 && D % 32 == 0 && D <= 896 && F % 32 == 0 && F <= 192 && FS % 32 == 0 && FS / 32 <= 48 && K * GR + FS / 32 + 8 <= TFB_T && K <= 64);
+    static block_q8_1 * aq = nullptr; static float * wbuf = nullptr;
+    ggml_custom_op_params cp; memcpy(&cp, dst->op_params, sizeof(cp));
+    const intptr_t ud = (intptr_t) cp.userdata; const bool fold = (ud >> 17) & 1, normw = (ud >> 16) & 1;
+    // TEMPORAL_FUSED_SKIP (profiling, output wrong): 1 = do not launch A, 2 = do not launch B
+    static const int skip = [](){const char*e=getenv("TEMPORAL_FUSED_SKIP");return e?atoi(e):0;}();
+    if (!aq) {
+        CUDA_CHECK(cudaMalloc(&aq, TFB_C * sizeof(block_q8_1))); CUDA_CHECK(cudaMemset(aq, 0, TFB_C * sizeof(block_q8_1)));
+        CUDA_CHECK(cudaMalloc(&wbuf, 64 * sizeof(float)));
+        fprintf(stderr, "[temporal-fused] one fused op per MoE layer on single-token steps: D=%d F=%d FS=%d K=%d skip=%d\n", D, F, FS, K, skip);
+    }
+    TFA A; memset(&A, 0, sizeof A); TFB B; memset(&B, 0, sizeof B);
+    auto it = g_tptr.find(W[0]->data);
+    if (it != g_tptr.end()) {                                              // streamed: slots, pool, the routing op's swap list
+        TU & L = g_L[it->second.first];
+        GGML_ASSERT(L.remap_ids && L.R == K && (L.be[0] / 16) % GR == 0 && L.be[0] / 16 / GR <= 1024 && L.be[0] == L.be[1] && L.be[0] == L.be[2]);
+        for (int w = 0; w < 3; ++w) { A.W[w] = L.slot[w]; A.pool[w] = L.pool_dev[w]; }
+        A.ids = L.remap_ids; A.swp_e = L.d_swp_e; A.swp_s = L.d_swp_s; A.nswp = L.d_nswp; A.be = L.be[0];
+        B.poolD = L.pool_dev[2];
+    } else {                                                               // all in VRAM: the full tables, expert ids
+        for (int w = 0; w < 3; ++w) A.W[w] = (const uint8_t *) W[w]->data;
+        A.ids = (const int *) ids->data; A.be = W[0]->nb[2];
+    }
+    A.x = (const float *) x->data; A.SG = (const uint8_t *) Sx[0]->data; A.SU = (const uint8_t *) Sx[1]->data;
+    A.aq = aq; A.D = D; A.F = F; A.FS = FS; A.K = K;
+    if (fold) {
+        GGML_ASSERT(wgt->type == GGML_TYPE_F32 && wgt->ne[0] > 128 && wgt->ne[0] <= 256 && K <= 32);
+        A.lg = (const float *) wgt->data; A.eids = (const int *) ids->data; A.wgt = wbuf; A.E = (int) wgt->ne[0]; A.normw = normw;
+    }
+    const bool two = ggml_cuda_temporal_fused_on() == 2 && A.pool[0] != nullptr;      // copies run on the copy stream
+    TU * Lp = it != g_tptr.end() ? &g_L[it->second.first] : nullptr;
+    A.pass = two ? 0 : -1;
+    if (!(skip & 1)) k_tf_a<<<K * GR + FS / 32 + (fold ? 1 : 0), 1024, 0, stream>>>(A);
+    if (two && !(skip & 1)) {
+        TFA A1 = A; A1.pass = 1; A1.lg = nullptr;
+        if (tr_nocopy() != 2) cudaStreamWaitEvent(stream, Lp->ev[1], 0);              // gate and up of the loaded experts are in their slots
+        k_tf_a<<<K * GR, 1024, 0, stream>>>(A1);
+    }
+    B.aq = aq; B.wgt = fold ? wbuf : (const float *) wgt->data; B.Dn = A.W[2]; B.ids = A.ids; B.swp_e = A.swp_e; B.swp_s = A.swp_s; B.nswp = A.nswp;
+    B.SD = (const uint8_t *) Sx[2]->data; B.y = (float *) dst->data; B.be = A.be; B.D = D; B.F = F; B.FS = FS; B.K = K;
+    if (two) { B.poolD = nullptr; if (tr_nocopy() != 2) cudaStreamWaitEvent(stream, Lp->ev[2], 0); }
+    if (!(skip & 2)) k_tf_b<<<D, TFB_T, 0, stream>>>(B);
+    CUDA_CHECK(cudaGetLastError());
+}
