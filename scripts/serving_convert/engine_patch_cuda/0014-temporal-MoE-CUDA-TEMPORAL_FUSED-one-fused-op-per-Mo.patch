          ggml_tensor * cur,
          ggml_tensor * gate_inp,
@@ -1995,6 +2001,34 @@ ggml_tensor * llm_graph_context::build_moe_ffn(
     ggml_build_forward_expand(gf, weights);
     if (tm_after_router) { ggml_build_forward_expand(gf, tm_after_router); tm_after_router = nullptr; }
 
+    // TEMPORAL_FUSED=1 (CUDA, single-token steps, routing op on the device): everything after the gate weights
+    // -- shared expert, routed experts, weighting, sum over experts, + shared -- is one custom op that the CUDA
+    // backend runs as three launches (ggml_cuda_temporal_fused). The router, the softmax, the routing op and the
+    // gate-weight ops above stay ordinary nodes, so the selection, the loads and the weights are the engine's.
+    // Inputs: x, selected ids, gate weights, the routed gate/up/down tensors, the shared gate/up/down tensors.
+    {
+        static const bool tm_fused = getenv("TEMPORAL_FUSED") && atoi(getenv("TEMPORAL_FUSED"));
+        tm_fused_done = false;
+        ggml_tensor ** sh = tm_fused_shexp;
+        const bool q4 = up_exps && gate_exps && down_exps && sh[0] && sh[1] && sh[2]
+            && up_exps->type == GGML_TYPE_Q4_0 && gate_exps->type == GGML_TYPE_Q4_0 && down_exps->type == GGML_TYPE_Q4_0
+            && sh[0]->type == GGML_TYPE_Q4_0 && sh[1]->type == GGML_TYPE_Q4_0 && sh[2]->type == GGML_TYPE_Q4_0;
+        if (tm_fused && q4 && n_tokens == 1 && tm_trained && il >= 0 && selected_experts_in == nullptr && hparams.n_expert_groups <= 1
+                && !gate_up_exps && type_op == LLM_FFN_SILU && !up_exps_b && !gate_exps_b && !down_exps_b
