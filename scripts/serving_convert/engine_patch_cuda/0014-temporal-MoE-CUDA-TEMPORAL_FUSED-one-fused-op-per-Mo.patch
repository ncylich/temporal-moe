 }
 
+// TEMPORAL_FUSED has no CPU implementation: the op exists only in the CUDA backend
+static void ggml_temporal_fused_cpu(struct ggml_tensor * dst, int ith, int nth, void * userdata) {
+    (void) dst; (void) ith; (void) nth; (void) userdata;
