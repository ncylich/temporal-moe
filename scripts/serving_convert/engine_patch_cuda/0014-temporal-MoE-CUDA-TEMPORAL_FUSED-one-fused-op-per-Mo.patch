From 474e160965835e99f010d91995a1859f81d36303 Mon Sep 17 00:00:00 2001
From: Noah Cylich <noahcylich@gmail.com>
Date: Wed, 18 Nov 2026 00:45:43 -0800
Subject: [PATCH] temporal-MoE CUDA: TEMPORAL_FUSED, one fused op per MoE layer
 on single-token steps

Off by default. The shared expert, the routed experts, the weighting and the sum over experts of one token
become one custom op that the CUDA backend runs as three launches; on the streamed path the op moves the
experts the routing op selected from the host-mapped pool into their slots inside those launches, so no
copy kernels, events or second stream are involved. The router, the softmax, the routing op and the gate-weight
ops stay ordinary graph nodes. Q4_0 experts with glm4moe's shapes only; other models keep the old path.
---
 ggml/src/ggml-cuda/ggml-cuda.cu |   7 +-
 ggml/src/ggml-cuda/temporal.cu  | 267 +++++++++++++++++++++++++++++++-
 ggml/src/ggml-cuda/temporal.cuh |   5 +
 src/llama-graph.cpp             |  48 ++++++
 src/llama-graph.h               |   4 +
 src/models/glm4-moe.cpp         |  12 ++
 6 files changed, 338 insertions(+), 5 deletions(-)

diff --git a/ggml/src/ggml-cuda/ggml-cuda.cu b/ggml/src/ggml-cuda/ggml-cuda.cu
index bb562d44..77d54b6c 100644
--- a/ggml/src/ggml-cuda/ggml-cuda.cu
+++ b/ggml/src/ggml-cuda/ggml-cuda.cu
@@ -2416,8 +2416,9 @@ static bool ggml_cuda_compute_forward(ggml_backend_cuda_context & ctx, struct gg
         case GGML_OP_MUL_MAT_ID:
             ggml_cuda_mul_mat_id(ctx, dst);
             break;
-        case GGML_OP_CUSTOM:   // trained temporal routing (the only custom op supports_op accepts)
-            ggml_cuda_temporal_route(ctx.stream(), dst);
+        case GGML_OP_CUSTOM:   // trained temporal routing, or the fused MoE-layer op (the only custom ops supports_op accepts)
+            if (ggml_cuda_temporal_fused_op(dst)) ggml_cuda_temporal_fused(ctx.stream(), dst);
+            else ggml_cuda_temporal_route(ctx.stream(), dst);
             break;
         case GGML_OP_OUT_PROD:
             ggml_cuda_out_prod(ctx, dst);
@@ -4917,7 +4918,7 @@ static bool ggml_backend_cuda_device_supports_op(ggml_backend_dev_t dev, const g
 
     switch (op->op) {
         case GGML_OP_CUSTOM:
-            return ggml_cuda_temporal_route_op(op);
+            return ggml_cuda_temporal_route_op(op) || ggml_cuda_temporal_fused_op(op);
         case GGML_OP_UNARY:
             switch (ggml_get_unary_op(op)) {
                 case GGML_UNARY_OP_ABS:
diff --git a/ggml/src/ggml-cuda/temporal.cu b/ggml/src/ggml-cuda/temporal.cu
index dffd6614..63812f25 100644
--- a/ggml/src/ggml-cuda/temporal.cu
+++ b/ggml/src/ggml-cuda/temporal.cu
@@ -49,6 +49,14 @@ static int tr_slots();
 // expert next), single pass. Off by default.
 int ggml_cuda_temporal_load_first() { static int v=[](){const char*s=getenv("TEMPORAL_LOAD_FIRST");return s?atoi(s):0;}();
                                       return ggml_cuda_temporal_unified() ? v : 0; }
+// TEMPORAL_FUSED: one fused op per MoE layer on single-token steps (see the end of this file); it forces
+// TEMPORAL_ROUTE_SLOTS=2 (the routing kernel keeps the slot table and writes the swap list). Streamed:
+//   1  the op does the loads itself, inside its own launches; the routing op starts no copy kernels
+//   2  the copies start at the routing op on the copy stream, as without the op; the op's first launch computes
+//      the shared expert and the experts already in their slots and waits for nothing, a second launch
+//      computes the experts being loaded after their gate and up copies, and the down launch waits for the
+//      down copy
+int ggml_cuda_temporal_fused_on() { static int v=[](){const char*s=getenv("TEMPORAL_FUSED");return s?atoi(s):0;}(); return v; }
 int ggml_cuda_temporal_route_op_on();
 int ggml_cuda_temporal_route_mode();
 static int tr_nocopy();
@@ -455,6 +463,7 @@ int ggml_cuda_temporal_route_mode();
 static int tr_slots() { static int v=[](){const char*s=getenv("TEMPORAL_ROUTE_SLOTS");
                             return s ? atoi(s) : (ggml_cuda_temporal_route_mode()>=2 ? 2 : 0);}();
                         if (ggml_cuda_temporal_load_first()) return 2;
+                        if (ggml_cuda_temporal_fused_on() && ggml_cuda_temporal_unified()) return 2;
                         return v && ggml_cuda_temporal_unified(); }
