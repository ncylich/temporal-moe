                                             int32_t** ids_out_ptr, cudaStream_t stream);
 
+// TEMPORAL_FUSED: the fused MoE-layer op (shared expert, routed experts, weighting, sum), see temporal.cu
+int  ggml_cuda_temporal_fused_on();
