-    if (!(skip & 1)) k_tf_a<<<K * GR + FS / 32 + (fold ? 1 : 0), 1024, 0, stream>>>(A);
+    A.tail = dn_in_a ? ntail : 0;
+    if (!(skip & 1)) k_tf_a<<<K * GR + FS / 32 + (fold ? 1 : 0) + A.tail, 1024, 0, stream>>>(A);
