@@ -1444,9 +1455,13 @@ void ggml_cuda_temporal_fused(cudaStream_t stream, ggml_tensor * dst) {
         A.lg = (const float *) wgt->data; A.eids = (const int *) ids->data; A.wgt = wbuf; A.E = (int) wgt->ne[0]; A.normw = normw;
     }
     const bool two = ggml_cuda_temporal_fused_on() == 2 && A.pool[0] != nullptr;      // copies run on the copy stream
+    // 3: the down tensor of loaded experts is copied by blocks at the end of the first launch, not by the down launch
+    static const int ntail = [](){const char*e=getenv("TEMPORAL_FUSED_TAIL");return e?atoi(e):14;}();
+    const bool dn_in_a = ggml_cuda_temporal_fused_on() == 3 && A.pool[0] != nullptr;
     TU * Lp = it != g_tptr.end() ? &g_L[it->second.first] : nullptr;
