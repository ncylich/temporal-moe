         if (tr_nocopy() != 2) cudaStreamWaitEvent(stream, Lp->ev[1], 0);              // gate and up of the loaded experts are in their slots
@@ -1455,6 +1470,7 @@ void ggml_cuda_temporal_fused(cudaStream_t stream, ggml_tensor * dst) {
     B.aq = aq; B.wgt = fold ? wbuf : (const float *) wgt->data; B.Dn = A.W[2]; B.ids = A.ids; B.swp_e = A.swp_e; B.swp_s = A.swp_s; B.nswp = A.nswp;
     B.SD = Sx[2] ? (const uint8_t *) Sx[2]->data : nullptr; B.y = (float *) dst->data; B.be = A.be; B.D = D; B.F = F; B.FS = FS; B.K = K; B.cpv = cpv;
     if (two) { B.poolD = nullptr; if (tr_nocopy() != 2) cudaStreamWaitEvent(stream, Lp->ev[2], 0); }
+    if (dn_in_a) B.poolD = nullptr;
     if (!(skip & 2)) k_tf_b<<<D, bt, 0, stream>>>(B);
     CUDA_CHECK(cudaGetLastError());
 }
diff --git a/src/llama-graph.cpp b/src/llama-graph.cpp
