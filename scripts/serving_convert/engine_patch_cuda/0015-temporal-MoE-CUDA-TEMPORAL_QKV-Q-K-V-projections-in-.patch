     const char * src1_ddq_i, float * dst_dd_i, const int64_t row_low, const int64_t row_high, const int64_t src1_ncols,
     const int64_t src1_padded_row_size, cudaStream_t stream);
+
+// temporal: TEMPORAL_QKV. n (2 or 3) matrices of one type and shape times the same single vector, as one
+// quantisation of the vector and one launch. Row arithmetic is that of ggml_cuda_mul_mat_vec_q.
+void ggml_cuda_mul_mat_vec_q_multi(ggml_backend_cuda_context & ctx, const ggml_tensor ** src0s, const ggml_tensor * src1,
+                                   ggml_tensor ** dsts, int n);
diff --git a/ggml/src/ggml-cuda/temporal.cu b/ggml/src/ggml-cuda/temporal.cu
index c40b5a58..ba017269 100644
--- a/ggml/src/ggml-cuda/temporal.cu
+++ b/ggml/src/ggml-cuda/temporal.cu
@@ -1108,7 +1108,7 @@ static void tr2_route(cudaStream_t stream, ggml_tensor * dst, int L, int K, int
     if (sl && tr_slots() == 2 && n_tokens == 1 && (tu_swap_n() >= 0 || tu_swap_hist() > 0))
         k_force_route<<<1, K, 0, stream>>>(T->d_swp_e, T->d_swp_s, T->d_nswp, tu_swap_n(), E, K, T->remap_ids, T->split_ids,
                                            tu_swap_hist() > 0 ? g_hist_cum : nullptr, g_hist_n);
-    if (sl && tr_slots() == 2 && n_tokens == 1 && tr_nocopy() != 2 && ggml_cuda_temporal_fused_on() != 1) {   // copies start at the router; =1 leaves them to the expert op
+    if (sl && tr_slots() == 2 && n_tokens == 1 && tr_nocopy() != 2 && ggml_cuda_temporal_fused_on() == 2) {   // copies start at the router; 1 and 3 leave them to the expert op
         cudaEventRecord(T->fork, stream);
         cudaStreamWaitEvent(g_copy, T->fork, 0);
         for (int w = 0; w < 3; ++w) {
@@ -1174,7 +1174,7 @@ void ggml_cuda_temporal_route(cudaStream_t stream, ggml_tensor * dst) {
     // TEMPORAL_ROUTE_SLOTS=2: the swap list exists now, so start the copies here instead of at the gate
     // GEMM. They run on the copy stream under whatever the graph has between the router and the routed
     // experts (gate weights, and the shared expert when the graph puts it first).
-    if (sl && tr_slots() == 2 && n_tokens == 1 && ggml_cuda_temporal_fused_on() != 1) {
+    if (sl && tr_slots() == 2 && n_tokens == 1 && (ggml_cuda_temporal_fused_on() == 0 || ggml_cuda_temporal_fused_on() == 2)) {
         cudaEventRecord(T->fork, stream);
         cudaStreamWaitEvent(g_copy, T->fork, 0);
         for (int w = 0; w < 3; ++w) {
@@ -1266,6 +1266,7 @@ struct TFA {
     size_t be; int D, F, FS, K;
     const float * lg; const int * eids; float * wgt; int E, normw;        // gate weights from the router logits (lg null: not here)
     int pass;       // -1: every position, loading ones copied here; 0: positions not being loaded; 1: only those being loaded
+    int tail;       // TEMPORAL_FUSED=3: this many blocks at the end of the launch copy the down tensor of the experts being loaded
 };
 // One block per 32 rows of one expert: gate rows, up rows, SwiGLU, and the Q8_1 block of those 32 activations.
 // Routed positions are taken in the order "experts being loaded first", so their blocks are scheduled first
@@ -1274,6 +1275,16 @@ __global__ void k_tf_a(TFA A) {
     __shared__ block_q8_1 xq[32]; __shared__ float act[32]; __shared__ int s_c, s_e;
     const int lane = threadIdx.x & 31, row = threadIdx.x >> 5, blk = blockIdx.x;
     const int DB = A.D / 32, GR = A.F / 32, NR = A.K * GR;
+    if (blk >= (int) gridDim.x - A.tail) {
+        // host pool -> slot for the down tensor of every expert being loaded, for the launch after this one. These
+        // blocks are last in the launch: they start as the resident experts' blocks finish, when the link has
+        // delivered gate and up and would idle while the loaded experts' rows are computed.
+        const long nv = (long) (A.be / 16), n = (long) A.tail * 1024; const int ns = min(*A.nswp, A.K);
+        for (int k = 0; k < ns; ++k)
+            for (long v = (long) (blk - ((int) gridDim.x - A.tail)) * 1024 + threadIdx.x; v < nv; v += n)
+                ((uint4 *) A.W[2])[(size_t) A.swp_s[k] * nv + v] = ((const uint4 *) A.pool[2])[(size_t) A.swp_e[k] * nv + v];
