+        return strcmp(s,"trained")==0 ? 1 : strcmp(s,"decode")==0 ? 2 : strcmp(s,"skliar")==0 ? 3 : 0;}();
     return v;
 }
+int ggml_cuda_temporal_route_trained() { return ggml_cuda_temporal_route_mode() != 0; }
 int ggml_cuda_temporal_route_op_on() {                  // trained routing runs as the CUDA kernel
     static int host=[](){const char*s=getenv("TEMPORAL_ROUTE_HOST");return s?atoi(s):0;}();
     return ggml_cuda_temporal_route_trained() && !host;
@@ -450,11 +466,351 @@ static void tr_report() {
     if (g_tr_dump) { fclose(g_tr_dump); g_tr_dump=nullptr; }
 }
 
+// ===== RELEASED-MODEL ROUTING (LLAMA_TEMPORAL_ROUTE=decode | skliar) =====
+// Both modes take the router logits [E, n_tokens] and write the selected ids [K, n_tokens], keep their state
+// per layer on the device, and (streamed, single token) keep the K VRAM slots in the same kernel with the same
+// slot routine, so the two streamed arms differ only in which experts they select.
+//
+// decode (analysis/residency/decode_state.py): a batch of more than one token is a prompt. It is routed
+//   freely (stock top-K of the logits) while the rule runs observe-only over it: cold fill with the top-K of
+//   the sequence's first token, then on every token admit the best non-resident expert iff its logit is
+//   strictly above the worst resident's, evicting that resident (min_logit). A single-token batch is one rule
+//   step and is routed inside the resident set (R = K, so the set is the selection). Ties: lowest expert index
+//   (nominee, worst resident, cold fill), as torch.max / argmin / topk on the reference's CPU path.
+// skliar (analysis/residency/cache_bias.py, Skliar et al. arXiv:2412.00099): per layer an LRU cache of C
+//   experts (last-use time, -1 = not cached) and delta = running mean over every token seen of
+//   max(z) - min(z). A prompt batch (or the first token of a sequence) is routed freely and warms the cache:
+//   last-use = the token's index in the batch for each of its top-K, then keep the C most recent (ties: higher
+//   expert index), and the step counter becomes (previous) + n_tokens. A decode token: z' = z + lambda*delta on
+//   cached experts; select top-K of z'; if the top-1 of z is not selected it replaces the selected expert with
+//   the lowest z' (J = 1); loads = selected experts not cached; then last-use = step for the selection, step+1,
+//   keep the C most recent. Gate weights come from the stock graph (softmax of z gathered at the ids,
+//   renormalised), which equals the reference's softmax over the selected logits.
+// Exit line `temporal-route2: ...` with loads per decode layer-token and their histogram;
+// TEMPORAL_ROUTE_HIST=<json> writes {"hist","loads","rows"} like cache_bias.stats();
+// LLAMA_TEMPORAL_ROUTE_DUMP2=<file> writes, per layer and token: int32 layer, n_tokens, t, loads (-1 if not a
+// counted decode step), K int32 ids, E float32 logits (syncs after every op: needs GGML_CUDA_DISABLE_GRAPHS=1);
+// a record with layer -1 marks a sequence reset (position 0).
+#define TR2_MAXK 64
+struct TR2 {
+    int E = 0, K = 0, C = 0, J = 1; float lam = 0.f; int ready = 0;
+    int *st = nullptr, *win = nullptr, *last = nullptr, *sloth = nullptr, *svalid = nullptr, *tokl = nullptr; int ntokl = 0;
+    long long *tnow = nullptr; double *dsum = nullptr; unsigned long long *dn = nullptr, *hist = nullptr, *cnt = nullptr;
+    FILE * dump = nullptr;
+};
+static TR2 g2;
+
+static __device__ inline float tr2_val(unsigned k) {   // inverse of tr_key
+    return __uint_as_float((k & 0x80000000u) ? (k ^ 0x80000000u) : ~k);
+}
+static __device__ inline unsigned long long tr2_hi(float v, unsigned lo) { return (tr_key(v) << 32) | (unsigned long long) lo; }
+
+// block-wide max of a and min of b (64-bit keys), warp shuffles then one pass over the warps; all threads
+// get the result. Needs blockDim.x a multiple of 32, at most 1024.
+static __device__ void tr2_reduce(unsigned long long & a, unsigned long long & b) {
+    __shared__ unsigned long long wa[32], wb[32];
+    for (int o = 16; o > 0; o >>= 1) {
+        const unsigned long long oa = __shfl_xor_sync(0xFFFFFFFFu, a, o), ob = __shfl_xor_sync(0xFFFFFFFFu, b, o);
+        a = oa > a ? oa : a; b = ob < b ? ob : b;
+    }
+    const int w = threadIdx.x >> 5, nw = blockDim.x >> 5;
+    if ((threadIdx.x & 31) == 0) { wa[w] = a; wb[w] = b; }
+    __syncthreads();
+    a = wa[0]; b = wb[0];
+    for (int i = 1; i < nw; ++i) { a = wa[i] > a ? wa[i] : a; b = wb[i] < b ? wb[i] : b; }
+    __syncthreads();
+}
+// rank of v[e] among all experts (greater first, lower index first on ties); the K best go to outk[rank]
+// E <= 256: one warp, up to 8 values per lane in registers, K rounds of warp argmax (the scheme of the stock
+// fused top-k MoE kernel). Larger E: rank count with no early exit (every lane reads the same float4, a
+// broadcast, and the loop pipelines; E % 4 == 0).
+static __device__ void tr2_topk(const float * v, int E, int K, int * outk) {
+    if (E <= 256) {
+        if (threadIdx.x < 32) {
+            const int lane = threadIdx.x;
+            unsigned long long key[8];
+#pragma unroll
+            for (int i = 0; i < 8; ++i) { const int e = lane + 32*i; key[i] = e < E ? tr2_hi(v[e], 0xFFFFFFFFu - (unsigned) e) : 0ull; }
+            for (int k = 0; k < K; ++k) {
+                unsigned long long best = 0ull;
+#pragma unroll
+                for (int i = 0; i < 8; ++i) best = key[i] > best ? key[i] : best;
+                unsigned long long m = best;
+#pragma unroll
+                for (int o = 16; o > 0; o >>= 1) { const unsigned long long t = __shfl_xor_sync(0xFFFFFFFFu, m, o); m = t > m ? t : m; }
+                if (lane == 0) outk[k] = (int) (0xFFFFFFFFu - (unsigned) (m & 0xFFFFFFFFull));
+#pragma unroll
+                for (int i = 0; i < 8; ++i) if (key[i] == m) key[i] = 0ull;   // keys are unique (index inside)
+            }
+        }
+        __syncthreads();
+        return;
+    }
+    const float4 * v4 = (const float4 *) v;
+    for (int e = threadIdx.x; e < E; e += blockDim.x) {
+        const float a = v[e]; int r = 0;
+#pragma unroll 8
+        for (int f4 = 0; f4 < (E >> 2); ++f4) {
+            const float4 b = v4[f4]; const int f = f4 << 2;
+            r += (b.x > a) | ((b.x == a) & (f     < e));
+            r += (b.y > a) | ((b.y == a) & (f + 1 < e));
+            r += (b.z > a) | ((b.z == a) & (f + 2 < e));
+            r += (b.w > a) | ((b.w == a) & (f + 3 < e));
+        }
+        if (r < K) outk[r] = e;
+    }
+    __syncthreads();
+}
+// keep the C most recently used cached experts (last-use in lu[], -1 = not cached; ties: higher index kept)
+static __device__ void tr2_cap(int * lu, int * tmp, int E, int C) {
+    for (int e = threadIdx.x; e < E; e += blockDim.x) {
+        int r = 0; const int a = lu[e];
+        if (a >= 0) for (int f = 0; f < E; ++f) { const int b = lu[f]; r += (b >= 0) && (b > a || (b == a && f > e)); }
+        tmp[e] = r;
+    }
+    __syncthreads();
+    for (int e = threadIdx.x; e < E; e += blockDim.x) if (lu[e] >= 0 && tmp[e] >= C) lu[e] = -1;
+    __syncthreads();
+}
+
+__global__ void k_route2(const float * __restrict__ lg, size_t stride, int n_tokens, int E, int K, int mode,
+                         int C, float lam, int J,
+                         int * st, int * win, int * last, long long * tnow, double * dsum, unsigned long long * dn,
+                         unsigned long long * hist, unsigned long long * cnt, int32_t * __restrict__ out, int * tokl,
+                         int * sloth, int * svalid, int * swp_e, int * swp_s, int * nswp, int32_t * remap,
+                         unsigned long long * ncopy, int nocopy) {
+    extern __shared__ float sh2[];
+    float * x = sh2; float * z = sh2 + E; int * lu = (int *) (sh2 + 2*E); int * tmp = lu + E;
+    __shared__ int s_ids[TR2_MAXK], s_win[TR2_MAXK], s_state, s_loads;
+    __shared__ unsigned long long s_a, s_b; __shared__ float s_bias;
+    const int tid = threadIdx.x, nt = blockDim.x;
+    if (tid == 0) s_state = *st;
+    for (int j = tid; j < K; j += nt) s_win[j] = win[j];
+    if (mode == 3) for (int e = tid; e < E; e += nt) lu[e] = last[e];
+    __syncthreads();
+    for (int t = 0; t < n_tokens; ++t) {
+        const float * xt = lg + (size_t) t * stride;
+        for (int e = tid; e < E; e += nt) x[e] = xt[e];
+        if (tid == 0) { s_loads = -1; s_a = 0ull; s_b = ~0ull; }
+        __syncthreads();
+        if (mode == 2) {
+            if (s_state == 0) {                                   // cold fill = top-K of this token
+                tr2_topk(x, E, K, s_ids);
+                if (tid == 0) { for (int j = 0; j < K; ++j) s_win[j] = s_ids[j]; s_state = 1; if (n_tokens == 1) cnt[3]++; }
+            } else {
+                for (int e = tid; e < E; e += nt) tmp[e] = 0;
+                __syncthreads();
+                for (int j = tid; j < K; j += nt) tmp[s_win[j]] = 1;
+                __syncthreads();
+                unsigned long long ra = 0ull, rb = ~0ull;
+                for (int e = tid; e < E; e += nt) {
+                    if (!tmp[e]) { const unsigned long long k = tr2_hi(x[e], 0xFFFFFFFFu - (unsigned) e); ra = k > ra ? k : ra; }  // best non-resident
+                    else         { const unsigned long long k = tr2_hi(x[e], (unsigned) e); rb = k < rb ? k : rb; }                 // worst resident
+                }
+                tr2_reduce(ra, rb);
+                if (tid == 0) { s_a = ra; s_b = rb; }
+                __syncthreads();
+                if (tid == 0) {
+                    const int nom = (int) (0xFFFFFFFFu - (unsigned) (s_a & 0xFFFFFFFFull)), ws = (int) (s_b & 0xFFFFFFFFull);
+                    int sw = 0;
+                    if (x[nom] > x[ws]) { for (int j = 0; j < K; ++j) if (s_win[j] == ws) { s_win[j] = nom; break; } sw = 1; }
+                    if (n_tokens == 1) { s_loads = sw; cnt[0]++; cnt[1] += sw; hist[sw]++; }
+                }
+                __syncthreads();
+                if (n_tokens == 1) { if (tid == 0) for (int j = 0; j < K; ++j) s_ids[j] = s_win[j]; }
+                else tr2_topk(x, E, K, s_ids);                    // prompt: free routing
+            }
+        } else {                                                  // mode 3: skliar
+            {
+                unsigned long long ra = 0ull, rb = ~0ull;            // max with lowest-index tie (= top-1), min
+                for (int e = tid; e < E; e += nt) {
+                    const unsigned long long ka = tr2_hi(x[e], 0xFFFFFFFFu - (unsigned) e), kb = tr2_hi(x[e], (unsigned) e);
+                    ra = ka > ra ? ka : ra; rb = kb < rb ? kb : rb;
+                }
+                tr2_reduce(ra, rb);
+                if (tid == 0) { s_a = ra; s_b = rb; }
+            }
+            __syncthreads();
+            if (tid == 0) {                                       // delta: running mean of max - min (float32 difference)
+                const float mx = tr2_val((unsigned) (s_a >> 32)), mn = tr2_val((unsigned) (s_b >> 32));
+                *dsum += (double) (mx - mn); *dn += 1ull;
+                s_bias = (float) ((double) lam * (*dsum / (double) *dn));
+            }
+            __syncthreads();
+            if (n_tokens > 1 || s_state == 0) {                   // prompt / first token: free, warms the cache
+                if (t == 0) { for (int e = tid; e < E; e += nt) lu[e] = -1; __syncthreads(); }
+                tr2_topk(x, E, K, s_ids);
+                for (int j = tid; j < K; j += nt) lu[s_ids[j]] = t;
+                __syncthreads();
+                if (t == n_tokens - 1) { tr2_cap(lu, tmp, E, C); if (tid == 0) { *tnow = (s_state ? *tnow : 0) + n_tokens; s_state = 1; } }
+            } else {
+                for (int e = tid; e < E; e += nt) z[e] = x[e] + (lu[e] >= 0 ? s_bias : 0.0f);
+                __syncthreads();
+                tr2_topk(z, E, K, s_ids);                         // s_a still holds the top-1 of z (from the delta pass)
+                if (tid == 0) {
+                    if (J > 0) {
+                        const int top1 = (int) (0xFFFFFFFFu - (unsigned) (s_a & 0xFFFFFFFFull));
+                        int in = 0, wj = 0;
+                        for (int j = 0; j < K; ++j) { in |= s_ids[j] == top1; if (z[s_ids[j]] < z[s_ids[wj]]) wj = j; }
+                        if (!in) s_ids[wj] = top1;
+                    }
+                    int ld = 0; for (int j = 0; j < K; ++j) ld += lu[s_ids[j]] < 0;
+                    const int step = (int) *tnow;
+                    for (int j = 0; j < K; ++j) lu[s_ids[j]] = step;
+                    *tnow = step + 1;
+                    s_loads = ld; cnt[0]++; cnt[1] += ld; hist[ld]++;
+                }
+                __syncthreads();
+                if (C == K) { const int step = (int) *tnow - 1; for (int e = tid; e < E; e += nt) if (lu[e] != step) lu[e] = -1; __syncthreads(); }
+                else tr2_cap(lu, tmp, E, C);
+            }
+        }
+        __syncthreads();
+        for (int j = tid; j < K; j += nt) out[(size_t) t*K + j] = s_ids[j];
+        if (tokl && tid == 0) tokl[t] = s_loads;
+        __syncthreads();
+    }
+    if (n_tokens > 1 && tid == 0) cnt[2] += n_tokens;
+    for (int j = tid; j < K; j += nt) win[j] = s_win[j];
+    if (mode == 3) for (int e = tid; e < E; e += nt) last[e] = lu[e];
+    if (tid == 0) *st = s_state;
+    if (!sloth) return;
+    if (n_tokens != 1) { if (tid == 0) *svalid = 0; return; }   // a batch ran through the prefill ring: slots stale
+    __syncthreads();
+    if (tid == 0) {                                             // slots follow the selection (same routine, both modes)
+        int ns = 0;
+        if (!*svalid) {
+            for (int j = 0; j < K; ++j) { sloth[j] = s_ids[j]; swp_e[j] = s_ids[j]; swp_s[j] = j; remap[j] = j; }
+            ns = K;
+        } else {
+            int keep[TR2_MAXK], hold[TR2_MAXK], miss[TR2_MAXK], nm = 0;
+            for (int s = 0; s < K; ++s) { hold[s] = sloth[s]; keep[s] = 0; }
+            for (int j = 0; j < K; ++j) {
+                int found = -1;
+                for (int s = 0; s < K; ++s) if (hold[s] == s_ids[j]) { found = s; break; }
+                if (found >= 0) { keep[found] = 1; remap[j] = found; } else miss[nm++] = j;
+            }
+            int sp = 0;
+            for (int m = 0; m < nm; ++m) {
+                while (keep[sp]) sp++;                          // lowest free slot: its expert is not selected
+                const int j = miss[m];
+                sloth[sp] = s_ids[j]; remap[j] = sp; swp_e[ns] = s_ids[j]; swp_s[ns] = sp; ns++; keep[sp] = 1;
+            }
+        }
+        *nswp = nocopy ? 0 : ns; *ncopy += ns; *svalid = 1;
+    }
+}
+
+static void tr2_report() {
+    if (!g2.ready) return;
+    const int H = g2.K + 1;
+    std::vector<unsigned long long> h((size_t) TR_MAXLAYER*H), c((size_t) TR_MAXLAYER*4);
+    cudaDeviceSynchronize();
+    cudaMemcpy(h.data(), g2.hist, h.size()*sizeof(unsigned long long), cudaMemcpyDeviceToHost);
+    cudaMemcpy(c.data(), g2.cnt, c.size()*sizeof(unsigned long long), cudaMemcpyDeviceToHost);
+    std::vector<unsigned long long> ht(H, 0); unsigned long long rows = 0, loads = 0, pre = 0, cold = 0; int nl = 0;
+    for (int L = 0; L < TR_MAXLAYER; ++L) {
+        if (!c[L*4] && !c[L*4+2]) continue;
+        nl++; rows += c[L*4]; loads += c[L*4+1]; pre += c[L*4+2]; cold += c[L*4+3];
+        for (int i = 0; i < H; ++i) ht[i] += h[(size_t) L*H + i];
+    }
+    const int mode = ggml_cuda_temporal_route_mode();
+    fprintf(stderr, "temporal-route2: mode=%s layers=%d decode_layer_tokens=%llu loads=%llu loads_per_layer_token=%.4f "
+            "prompt_layer_tokens=%llu cold_decode=%llu C=%d lambda=%.3f J=%d hist=[", mode == 2 ? "decode" : "skliar", nl,
+            rows, loads, rows ? (double) loads / (double) rows : 0.0, pre, cold, g2.C, g2.lam, g2.J);
+    for (int i = 0; i < H; ++i) fprintf(stderr, "%s%llu", i ? "," : "", ht[i]);
+    fprintf(stderr, "]\n");
+    const char * hp = getenv("TEMPORAL_ROUTE_HIST");
+    if (hp && hp[0]) { FILE * f = fopen(hp, "w"); if (f) {
+        fprintf(f, "{\"hist\": ["); for (int i = 0; i < 64; ++i) fprintf(f, "%s%llu", i ? ", " : "", i < H ? ht[i] : 0ull);
+        fprintf(f, "], \"loads\": %llu, \"rows\": %llu, \"mode\": \"%s\"}\n", loads, rows, mode == 2 ? "decode" : "skliar"); fclose(f); } }
+    if (g2.dump) { fclose(g2.dump); g2.dump = nullptr; }
+}
+
+static void tr2_reset() {
+    if (!g2.ready) return;
+    CUDA_CHECK(cudaDeviceSynchronize());
+    if (g2.dump) {                                            // sequence start marker: layer -1, rest zero
+        std::vector<int32_t> z((size_t) 4 + g2.K + g2.E, 0); z[0] = -1;
+        fwrite(z.data(), 4, z.size(), g2.dump);
+    }
+    CUDA_CHECK(cudaMemset(g2.st, 0, TR_MAXLAYER*sizeof(int)));
+    CUDA_CHECK(cudaMemset(g2.tnow, 0, TR_MAXLAYER*sizeof(long long)));
+}
