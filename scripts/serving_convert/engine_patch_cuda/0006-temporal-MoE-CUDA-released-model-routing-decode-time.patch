+        CUDA_CHECK(cudaMalloc(&g2.cnt, TR_MAXLAYER*4*sizeof(unsigned long long))); CUDA_CHECK(cudaMemset(g2.cnt, 0, TR_MAXLAYER*4*sizeof(unsigned long long)));
+        CUDA_CHECK(cudaMalloc(&g2.sloth, (size_t) TR_MAXLAYER*K*sizeof(int)));
+        CUDA_CHECK(cudaMalloc(&g2.svalid, TR_MAXLAYER*sizeof(int)));      CUDA_CHECK(cudaMemset(g2.svalid, 0, TR_MAXLAYER*sizeof(int)));
