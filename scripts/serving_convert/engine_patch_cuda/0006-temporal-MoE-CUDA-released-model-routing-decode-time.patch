 static unsigned long long *g_tr_cnt = nullptr;           // [TR_MAXLAYER*3]: steps, swaps, cold fills
 static int g_tr_K = 0;
 static int *g_tr_vslot = nullptr, *g_tr_vvalid = nullptr; // [TR_MAXLAYER*K], [TR_MAXLAYER] (TEMPORAL_ROUTE_SLOTS)
-static int tr_slots() { static int v=[](){const char*s=getenv("TEMPORAL_ROUTE_SLOTS");return s?atoi(s):0;}();
+int ggml_cuda_temporal_route_mode();
+// released-model modes (decode, skliar) always keep the slots in the routing kernel and start the copies there
+static int tr_slots() { static int v=[](){const char*s=getenv("TEMPORAL_ROUTE_SLOTS");int x=s?atoi(s):0;
+                            return ggml_cuda_temporal_route_mode()>=2 ? 2 : x;}();
                         return v && ggml_cuda_temporal_unified(); }
+// TEMPORAL_ROUTE_NOCOPY (released-model modes, timing controls, output wrong): 1 = copy kernels launched
+// with an empty swap list (no bytes moved); 2 = no copy kernels, no events, nothing waited on.
+static int tr_nocopy() { static int v=[](){const char*s=getenv("TEMPORAL_ROUTE_NOCOPY");return s?atoi(s):0;}(); return v; }
 static FILE * g_tr_dump = nullptr;
+static void tr2_route(cudaStream_t stream, ggml_tensor * dst, int L, int K, int n_tokens, int E);
+static void tr2_reset();
 
-int ggml_cuda_temporal_route_trained() {
-    static int v=[](){const char*s=getenv("LLAMA_TEMPORAL_ROUTE"); return s && strcmp(s,"trained")==0;}();
+// LLAMA_TEMPORAL_ROUTE: trained = 1 (the 1.26B model's training rule, prefill included);
+// decode = 2 (released models, analysis/residency/decode_state.py: prompt free, observe-only scan, one rule
+// step per generated token); skliar = 3 (analysis/residency/cache_bias.py: LRU cache of C per layer, bias
+// lambda on cached logits, top-J guarantee, prompt observed unbiased).
+int ggml_cuda_temporal_route_mode() {
