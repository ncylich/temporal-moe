@@ -43,6 +43,8 @@ static int tu_overlap() { static int v=[](){ if (getenv("TEMPORAL_UNIFIED_NOOVER
 static int tu_lean() { static int v=[](){const char*s=getenv("TEMPORAL_UNIFIED_LEAN");return s?atoi(s):0;}(); return v; }
