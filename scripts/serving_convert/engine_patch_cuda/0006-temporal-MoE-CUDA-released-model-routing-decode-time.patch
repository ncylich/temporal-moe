@@ -242,7 +244,7 @@ extern "C" int ggml_cuda_temporal_unified_remap(const void* src0_data, const int
     int64_t need = (int64_t)stride1 * n_tokens;
     if (L.remap_words < need) { if (L.remap_ids) cudaFree(L.remap_ids); cudaMalloc(&L.remap_ids, need*sizeof(int32_t)); L.remap_words = need; }
     if (tr_slots() == 2 && ggml_cuda_temporal_route_op_on() && n_tokens == 1) {   // copies were issued at the route op
-        cudaStreamWaitEvent(stream, L.ev[which], 0);
