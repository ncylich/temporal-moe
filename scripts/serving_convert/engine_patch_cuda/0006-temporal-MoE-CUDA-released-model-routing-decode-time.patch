+        g2.ready = 1;
+        atexit(tr2_report);
+        fprintf(stderr, "[temporal-route2] mode=%s K=%d E=%d C=%d lambda=%.3f J=%d nocopy=%d\n", mode == 2 ? "decode" : "skliar",
+                K, E, g2.C, g2.lam, g2.J, tr_nocopy());
+    }
+    GGML_ASSERT(K == g2.K && E == g2.E);
+    TU * T = (tr_slots() && L < (int) g_L.size() && g_L[L].ready) ? &g_L[L] : nullptr;
+    const bool sl = T != nullptr;
+    if (sl) {
+        GGML_ASSERT(T->R == K && T->E == E && (mode == 2 || g2.C == K));   // the cache is the slots
+        if (T->remap_words < K) {
