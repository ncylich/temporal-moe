From 77a2d48ed06754e778bde6d168a7c6f6a5a5957c Mon Sep 17 00:00:00 2001
From: Noah Cylich <noahcylich@gmail.com>
Date: Wed, 18 Nov 2026 12:31:56 -0800
Subject: [PATCH] temporal-MoE CUDA: TEMPORAL_ROPE_PAIR, RoPE of Q and K, the
 cache writes and (=2) the q/k norms in one launch

TEMPORAL_ROPE_PAIR=1: ROPE (Q), ROPE + VIEW + SET_ROWS (K into the KV cache) and SET_ROWS (V into the
cache) run as one launch. The stock rope_norm / rope_neox kernels become bodies shared with the new
kernel, so Q and K get the stock arithmetic; V is k_set_rows' cast.

TEMPORAL_ROPE_PAIR=2: qwen3moe places the q and k norms before both RoPEs in the graph, and the launch
first computes each row's RMS norm * weight (rms_norm_f32<256, true>'s arithmetic and reduction) into
the buffer RoPE then reads.

Off by default.
---
 ggml/src/ggml-cuda/ggml-cuda.cu |  45 ++++++++
 ggml/src/ggml-cuda/rope.cu      | 196 ++++++++++++++++++++++++++++++--
 ggml/src/ggml-cuda/rope.cuh     |   5 +
 src/models/qwen3moe.cpp         |  14 ++-
 4 files changed, 248 insertions(+), 12 deletions(-)

diff --git a/ggml/src/ggml-cuda/ggml-cuda.cu b/ggml/src/ggml-cuda/ggml-cuda.cu
index a98b8b4a..59439595 100644
--- a/ggml/src/ggml-cuda/ggml-cuda.cu
+++ b/ggml/src/ggml-cuda/ggml-cuda.cu
@@ -3343,6 +3343,51 @@ static int ggml_cuda_try_fuse(ggml_backend_cuda_context * cuda_ctx, ggml_cgraph
 
     ggml_tensor * node = cgraph->nodes[i];
 
+    // temporal, TEMPORAL_ROPE_PAIR=1: ROPE (Q), then after nodes that compute nothing ROPE + VIEW + SET_ROWS (K into the
+    // cache), then after more such nodes optionally SET_ROWS (V into the cache): one launch for all of it.
+    static const int tm_rpair = [](){const char*e=getenv("TEMPORAL_ROPE_PAIR");return e?atoi(e):0;}();
+    if (tm_rpair && (node->op == GGML_OP_ROPE || node->op == GGML_OP_RMS_NORM)) {
+        const auto skip_noop = [&](int k) { while (k < cgraph->n_nodes && (ggml_cuda_is_view_or_noop(cgraph->nodes[k]) ||
+                                                   !(cgraph->nodes[k]->flags & GGML_TENSOR_FLAG_COMPUTE))) k++; return k; };
+        // iq: the node of Q's ROPE. Returns the index of the last node done, or -1.
+        const auto try_pair = [&](int iq, const ggml_tensor * norm_q, const ggml_tensor * norm_k) {
+            if (iq >= cgraph->n_nodes || cgraph->nodes[iq]->op != GGML_OP_ROPE) return -1;
+            const int j = skip_noop(iq + 1);
+            if (j + 2 >= cgraph->n_nodes || cgraph->nodes[j]->op != GGML_OP_ROPE ||
+                !ggml_cuda_can_fuse(cgraph, j, { GGML_OP_ROPE, GGML_OP_VIEW, GGML_OP_SET_ROWS }, {})) return -1;
+            const int k = skip_noop(j + 3); ggml_tensor * set_v = nullptr;
+            if (k < cgraph->n_nodes && cgraph->nodes[k]->op == GGML_OP_SET_ROWS) set_v = cgraph->nodes[k];
+            for (int pass = 0; pass < 2; ++pass) {                    // with V's cache write, else without it
+                if (ggml_cuda_op_rope_pair(*cuda_ctx, cgraph->nodes[iq], cgraph->nodes[j], cgraph->nodes[j + 2], set_v, norm_q, norm_k)) {
+                    static bool said = false; if (!said) { said = true; fprintf(stderr, "temporal-rope-pair: %sRoPE of Q and K%s in one launch\n",
+                                                                                norm_q ? "norms and " : "", set_v ? " and the cache write of V" : ""); }
+                    return set_v ? k : j + 2;
+                }
+                if (!set_v) break;
+                set_v = nullptr;
+            }
+            return -1;
+        };
+        if (node->op == GGML_OP_ROPE) {
+            const int last = try_pair(i, nullptr, nullptr);
+            if (last >= 0) return last - i;
+        } else if (tm_rpair >= 2 && i + 4 < cgraph->n_nodes && ggml_cuda_can_fuse(cgraph, i, { GGML_OP_RMS_NORM, GGML_OP_MUL }, {})) {
+            // =2: [RMS_NORM, MUL] of Q, [RMS_NORM, MUL] of K, then the two ROPEs that read them (nodes that compute
+            // nothing may sit between)
+            const int i2 = skip_noop(i + 2);
+            if (i2 + 1 < cgraph->n_nodes && cgraph->nodes[i2]->op == GGML_OP_RMS_NORM && ggml_cuda_can_fuse(cgraph, i2, { GGML_OP_RMS_NORM, GGML_OP_MUL }, {})) {
+                const int iq = skip_noop(i2 + 2);
+                if (iq < cgraph->n_nodes && cgraph->nodes[iq]->op == GGML_OP_ROPE && cgraph->nodes[iq]->src[0] == cgraph->nodes[i + 1]) {
+                    const int jk = skip_noop(iq + 1);
+                    if (jk < cgraph->n_nodes && cgraph->nodes[jk]->src[0] == cgraph->nodes[i2 + 1]) {
+                        const int last = try_pair(iq, node, cgraph->nodes[i2]);
+                        if (last >= 0) return last - i;
+                    }
+                }
+            }
+        }
+    }
+
     // temporal, TEMPORAL_FUSED_ADD=1: the residual ADD that follows the fused MoE op is done by the op's down launch
     // (one float add per element, same operands). Only when the ADD is the next node and the op's only consumer.
     static const int tm_fadd = [](){const char*e=getenv("TEMPORAL_FUSED_ADD");return e?atoi(e):0;}();
