From 9d46adf0508dfc033a2f3862d6b376ab158eb781 Mon Sep 17 00:00:00 2001
From: Noah Cylich <noahcylich@gmail.com>
Date: Sat, 14 Nov 2026 02:23:40 -0800
Subject: [PATCH] temporal-MoE: TEMPORAL_SHEXP_FIRST orders the shared expert
 (qwen35moe) or dense MLP (gemma4) between the router and the routed experts

build_moe_ffn expands the routed-expert GEMMs itself, so a model cannot reorder them from outside.
llm_graph_context::tm_after_router is a node build_moe_ffn expands right after the router and the
gate weights. With the copies started at the router (patch 0006), the streamed expert copies then run
under the shared expert or dense MLP. Same ops and same add order, so the output is unchanged.
Replaces 0006's qwen35moe switch, which put the shared expert before the router.
---
 src/llama-graph.cpp      |  1 +
 src/llama-graph.h        |  4 ++++
 src/models/gemma4.cpp    |  4 ++++
 src/models/qwen35moe.cpp | 17 +++++++++++------
 4 files changed, 20 insertions(+), 6 deletions(-)

diff --git a/src/llama-graph.cpp b/src/llama-graph.cpp
index 26ca1641..fbf544b5 100644
--- a/src/llama-graph.cpp
+++ b/src/llama-graph.cpp
@@ -1983,6 +1983,7 @@ ggml_tensor * llm_graph_context::build_moe_ffn(
 
     //call early so that topk-moe can be used
     ggml_build_forward_expand(gf, weights);
+    if (tm_after_router) { ggml_build_forward_expand(gf, tm_after_router); tm_after_router = nullptr; }
 
     // temporal two-pass split: run the FFN twice through the *same* mul_mat_id kernel --
     // once for the K-1 resident experts (never stalls) and once for the 1 new expert
diff --git a/src/llama-graph.h b/src/llama-graph.h
index 97141ef9..42a9695a 100644
--- a/src/llama-graph.h
+++ b/src/llama-graph.h
@@ -933,6 +933,10 @@ struct llm_graph_context {
     ggml_context * ctx0 = nullptr;
     ggml_cgraph  * gf   = nullptr;
 
+    // temporal streaming: a node build_moe_ffn expands right after the router and gate weights, before the
+    // routed-expert GEMMs (TEMPORAL_SHEXP_FIRST=1), so expert copies started at the router run under it
+    mutable ggml_tensor * tm_after_router = nullptr;
+
     llm_graph_context(const llm_graph_params & params);
     virtual ~llm_graph_context() = default;
 
diff --git a/src/models/gemma4.cpp b/src/models/gemma4.cpp
index 6a96979c..ea2d04a5 100644
--- a/src/models/gemma4.cpp
+++ b/src/models/gemma4.cpp
@@ -1,3 +1,4 @@
+#include <cstdlib>
 #include "models.h"
 
 void llama_model_gemma4::load_arch_hparams(llama_model_loader & ml) {
@@ -320,6 +321,9 @@ llama_model_gemma4::graph::graph(const llama_model & model, const llm_graph_para
             ggml_tensor * logits = build_lora_mm(model.layers[il].ffn_gate_inp, tmp); // [n_expert, n_tokens]
             cb(logits, "ffn_moe_logits", il);
 
+            // TEMPORAL_SHEXP_FIRST=1: the dense MLP runs between the router and the routed experts
+            static const bool shexp_first = getenv("TEMPORAL_SHEXP_FIRST") && atoi(getenv("TEMPORAL_SHEXP_FIRST"));
+            if (shexp_first) tm_after_router = cur_mlp;
             cur_moe = build_moe_ffn(cur_moe,
                     nullptr, // gate_inp
                     model.layers[il].ffn_up_exps,
diff --git a/src/models/qwen35moe.cpp b/src/models/qwen35moe.cpp
index bca3a6c5..7bfb165d 100644
--- a/src/models/qwen35moe.cpp
+++ b/src/models/qwen35moe.cpp
@@ -498,20 +498,25 @@ ggml_tensor * llama_model_qwen35moe::graph::build_layer_ffn(ggml_tensor * cur, c
     // Check if this is an MoE layer
     GGML_ASSERT(model.layers[il].ffn_gate_inp != nullptr);
 
-    // TEMPORAL_SHEXP_FIRST=1: put the shared expert into the graph before the routed experts, so streamed
-    // expert copies started at the router run under it. Same ops, same sum; only the node order changes.
+    // TEMPORAL_SHEXP_FIRST=1: the shared expert is ordered between the router and the routed experts
+    // (llm_graph_context::tm_after_router). Same ops, same add order.
     static const bool shexp_first = getenv("TEMPORAL_SHEXP_FIRST") && atoi(getenv("TEMPORAL_SHEXP_FIRST"));
     ggml_tensor * shexp_early = nullptr;
     if (shexp_first && model.layers[il].ffn_up_shexp != nullptr) {
-        shexp_early = build_ffn(cur,
+        ggml_tensor * sh = build_ffn(cur,
                 model.layers[il].ffn_up_shexp, NULL, model.layers[il].ffn_up_shexp_s,
                 model.layers[il].ffn_gate_shexp, NULL, model.layers[il].ffn_gate_shexp_s,
                 model.layers[il].ffn_down_shexp, NULL, model.layers[il].ffn_down_shexp_s,
                 NULL,
                 LLM_FFN_SILU, LLM_FFN_PAR, il);
-        ggml_tensor * g = ggml_sigmoid(ctx0, build_lora_mm(model.layers[il].ffn_gate_inp_shexp, cur));
-        shexp_early = ggml_mul(ctx0, shexp_early, g);
-        ggml_build_forward_expand(gf, shexp_early);
+        cb(sh, "ffn_shexp", il);
+        ggml_tensor * g = build_lora_mm(model.layers[il].ffn_gate_inp_shexp, cur);
+        cb(g, "shared_expert_gate", il);
+        g = ggml_sigmoid(ctx0, g);
+        cb(g, "shared_expert_gate_sigmoid", il);
+        shexp_early = ggml_mul(ctx0, sh, g);
+        cb(shexp_early, "ffn_shexp_gated", il);
+        tm_after_router = shexp_early;
     }
 
     ggml_tensor * moe_out =
-- 
