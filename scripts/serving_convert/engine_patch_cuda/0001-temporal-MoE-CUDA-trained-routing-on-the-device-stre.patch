+
+// ===== TRAINED ROUTING on the device (LLAMA_TEMPORAL_ROUTE=trained) =====
+// CUDA twin of ggml_temporal_route (ggml-cpu.c): the training-time resident-window rule with
+// evict=min_logit. Cold fill = the K highest router logits of a sequence's first token (highest first);
+// every later token admits the best non-resident expert iff its logit is strictly above the worst
+// resident's, evicting that resident; the newcomer sits in slot K-1 and the previous newcomer fills the
+// gap. Ties break to the lowest expert index (nominee, cold fill) and the lowest window slot (worst), as
+// on the CPU. Window state lives on the device, so the op is one kernel inside the captured decode graph.
+// The streamed path needs nothing else: k_residency sees the window as the selected ids, so its nominee is
+// the admitted expert and its victim the evicted one.
+//   TEMPORAL_ROUTE_HOST=1          leave the op to the CPU backend (cross-check; splits the graph)
+//   LLAMA_TEMPORAL_ROUTE_DUMP=path every token's window: int32 layer, K int32 ids (syncs; needs
+//                                  GGML_CUDA_DISABLE_GRAPHS=1 for single-token batches)
+#include "ggml-impl.h"
+#include <cstdio>
+#define TR_MAXLAYER 128
+static int *g_tr_k = nullptr, *g_tr_win = nullptr;       // [TR_MAXLAYER], [TR_MAXLAYER*K]
+static unsigned long long *g_tr_cnt = nullptr;           // [TR_MAXLAYER*3]: steps, swaps, cold fills
+static int g_tr_K = 0;
+static FILE * g_tr_dump = nullptr;
+
+int ggml_cuda_temporal_route_trained() {
+    static int v=[](){const char*s=getenv("LLAMA_TEMPORAL_ROUTE"); return s && strcmp(s,"trained")==0;}();
+    return v;
+}
+bool ggml_cuda_temporal_route_op(const ggml_tensor * t) {
+    static int host=[](){const char*s=getenv("TEMPORAL_ROUTE_HOST");return s?atoi(s):0;}();
+    return ggml_cuda_temporal_route_trained() && !host && strncmp(t->name, "ffn_moe_route", 13) == 0
+        && t->type == GGML_TYPE_I32 && t->src[0] && t->src[0]->type == GGML_TYPE_F32;
+}
+
+static __device__ inline unsigned long long tr_key(float v) {   // float -> order-preserving u32
+    unsigned u = __float_as_uint(v);
+    return (unsigned long long)(u ^ ((u >> 31) ? 0xFFFFFFFFu : 0x80000000u));
+}
+__global__ void k_route(const float* __restrict__ lg, size_t stride, int n_tokens, int E, int K,
+                        int* kst, int* win, unsigned long long* cnt, int32_t* __restrict__ out) {
+    extern __shared__ int sh[];                           // [0,E) logits, [E,2E) resident flag
+    float* x = (float*) sh; int* in = sh + E;
+    __shared__ unsigned long long s_nom, s_wst; __shared__ int s_cold;
+    const int tid = threadIdx.x, nt = blockDim.x;
+    if (tid==0) s_cold = (*kst != K);
+    for (int e=tid; e<E; e+=nt) in[e]=0;
+    __syncthreads();
+    if (!s_cold) for (int j=tid; j<K; j+=nt) in[win[j]]=1;
+    __syncthreads();
+    for (int t=0; t<n_tokens; ++t) {
+        const float* xt = lg + (size_t)t*stride;
+        for (int e=tid; e<E; e+=nt) x[e]=xt[e];
+        __syncthreads();
+        if (s_cold) {                                     // rank of e among all logits = its window slot
+            for (int e=tid; e<E; e+=nt) {
+                const float v=x[e]; int r=0;
+                for (int f=0; f<E; ++f){ const float u=x[f]; r += (u>v) || (u==v && f<e); }
+                if (r<K){ win[r]=e; in[e]=1; }
+            }
+            __syncthreads();
+            if (tid==0){ *kst=K; s_cold=0; cnt[0]++; cnt[2]++; }
+        } else {
+            if (tid==0){ s_nom=0ull; s_wst=~0ull; }
+            __syncthreads();
+            for (int e=tid; e<E; e+=nt) if (!in[e]) atomicMax(&s_nom, (tr_key(x[e])<<32) | (0xFFFFFFFFu-(unsigned)e));
+            for (int j=tid; j<K; j+=nt) atomicMin(&s_wst, (tr_key(x[win[j]])<<32) | (unsigned)j);
+            __syncthreads();
+            if (tid==0){
+                const int nom = (int)(0xFFFFFFFFu-(unsigned)(s_nom & 0xFFFFFFFFull)), ws = (int)(s_wst & 0xFFFFFFFFull);
+                cnt[0]++;
+                if (x[nom] > x[win[ws]]) {
+                    in[win[ws]]=0;
+                    if (ws != K-1) win[ws]=win[K-1];
+                    win[K-1]=nom; in[nom]=1; cnt[1]++;
+                }
+            }
+        }
+        __syncthreads();
+        for (int j=tid; j<K; j+=nt) out[(size_t)t*K+j]=win[j];
+        __syncthreads();
+    }
+}
+
+static void tr_report() {
+    if (!g_tr_cnt) return;
+    std::vector<unsigned long long> c(TR_MAXLAYER*3, 0);
+    cudaDeviceSynchronize();
+    if (cudaMemcpy(c.data(), g_tr_cnt, c.size()*sizeof(unsigned long long), cudaMemcpyDeviceToHost) != cudaSuccess) {
+        fprintf(stderr, "temporal-route-cuda: counters unreadable at exit\n"); return;
+    }
+    unsigned long long st=0, sw=0, co=0, cp=0; int nl=0;
+    for (int L=0; L<TR_MAXLAYER; ++L) if (c[L*3]) { st+=c[L*3]; sw+=c[L*3+1]; co+=c[L*3+2]; nl++; }
+    fprintf(stderr, "temporal-route-cuda: trained min_logit, layers=%d layer_tokens=%llu cold_fills=%llu swaps=%llu "
+            "swaps_per_layer_token=%.4f\n", nl, st, co, sw, st>co ? (double)sw/(double)(st-co) : 0.0);
+    bool any=false;
+    for (auto & L : g_L) if (L.d_ncopy) { unsigned long long v=0;
+        if (cudaMemcpy(&v, L.d_ncopy, sizeof(v), cudaMemcpyDeviceToHost)==cudaSuccess) { cp+=v; any=true; } }
+    if (any) fprintf(stderr, "temporal-route-cuda: slot swap-ins decided on single-token steps=%llu\n", cp);
+    if (g_tr_dump) { fclose(g_tr_dump); g_tr_dump=nullptr; }
+}
+
+void ggml_cuda_temporal_route(cudaStream_t stream, ggml_tensor * dst) {
+    const ggml_tensor * lg = dst->src[0];
+    ggml_custom_op_params p; memcpy(&p, dst->op_params, sizeof(p));
+    const int L = (int)(intptr_t) p.userdata, K = (int) dst->ne[0], n_tokens = (int) dst->ne[1], E = (int) lg->ne[0];
+    GGML_ASSERT(L >= 0 && L < TR_MAXLAYER && K < E && E <= 4096 && lg->ne[1] == n_tokens);
+    if (!g_tr_k) {
+        g_tr_K = K;
+        CUDA_CHECK(cudaMalloc(&g_tr_k, TR_MAXLAYER*sizeof(int)));        CUDA_CHECK(cudaMemset(g_tr_k, 0, TR_MAXLAYER*sizeof(int)));
+        CUDA_CHECK(cudaMalloc(&g_tr_win, (size_t)TR_MAXLAYER*K*sizeof(int)));
+        CUDA_CHECK(cudaMalloc(&g_tr_cnt, TR_MAXLAYER*3*sizeof(unsigned long long)));
+        CUDA_CHECK(cudaMemset(g_tr_cnt, 0, TR_MAXLAYER*3*sizeof(unsigned long long)));
+        const char * d = getenv("LLAMA_TEMPORAL_ROUTE_DUMP");
+        if (d && d[0]) { g_tr_dump = fopen(d, "wb"); GGML_ASSERT(g_tr_dump); }
+        atexit(tr_report);
+    }
+    GGML_ASSERT(K == g_tr_K);
+    k_route<<<1, 256, (size_t)2*E*sizeof(int), stream>>>((const float *) lg->data, lg->nb[1]/sizeof(float), n_tokens, E, K,
+            g_tr_k + L, g_tr_win + (size_t)L*K, g_tr_cnt + (size_t)L*3, (int32_t *) dst->data);
+    CUDA_CHECK(cudaGetLastError());
+    if (g_tr_dump) {
+        std::vector<int32_t> h((size_t)K*n_tokens);
+        CUDA_CHECK(cudaStreamSynchronize(stream));
+        CUDA_CHECK(cudaMemcpy(h.data(), dst->data, h.size()*sizeof(int32_t), cudaMemcpyDeviceToHost));
+        const int32_t l32 = L;
+        for (int t=0; t<n_tokens; ++t) { fwrite(&l32, 4, 1, g_tr_dump); fwrite(h.data()+(size_t)t*K, 4, (size_t)K, g_tr_dump); }
+    }
+}
+
+// cold-start every layer's window (llama_context calls this at sequence position 0)
+void ggml_cuda_temporal_route_reset() {
+    if (!g_tr_k) return;
+    CUDA_CHECK(cudaDeviceSynchronize());
+    CUDA_CHECK(cudaMemset(g_tr_k, 0, TR_MAXLAYER*sizeof(int)));
+}
