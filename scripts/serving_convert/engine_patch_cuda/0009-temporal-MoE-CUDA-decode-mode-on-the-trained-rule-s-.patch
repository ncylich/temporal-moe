     GGML_ASSERT(L >= 0 && L < TR_MAXLAYER && K < E && E <= 4096 && lg->ne[1] == n_tokens);
-    if (ggml_cuda_temporal_route_mode() >= 2) { tr2_route(stream, dst, L, K, n_tokens, E); return; }
+    // decode mode runs on the trained rule's kernel (k_route, prompt batches routed by stock top-k);
+    // TEMPORAL_DECODE_K2=1 keeps it on k_route2 (the routing dump for route_check.py lives there)
+    static const bool dec_k2 = getenv("TEMPORAL_DECODE_K2") && atoi(getenv("TEMPORAL_DECODE_K2"));
