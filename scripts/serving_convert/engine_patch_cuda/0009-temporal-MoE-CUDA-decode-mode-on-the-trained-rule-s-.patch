         if (d && d[0]) { g_tr_dump = fopen(d, "wb"); GGML_ASSERT(g_tr_dump); }
+        const char * d2 = getenv("LLAMA_TEMPORAL_ROUTE_DUMP2");
+        if (d2 && d2[0] && ggml_cuda_temporal_route_mode() == 2) { g_tr_dump2 = fopen(d2, "wb"); GGML_ASSERT(g_tr_dump2); g_tr_E = E; }
