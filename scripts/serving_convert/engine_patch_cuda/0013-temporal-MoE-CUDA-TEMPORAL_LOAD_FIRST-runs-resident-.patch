+                                             (int) ids->ne[1], &tu_split, cuda_ctx->stream());
+                tu_ids_tensor      = *ids;
+                tu_ids_tensor.data = tu_split;
+                ids                = &tu_ids_tensor;
+            } else
             if (op == GGML_OP_MUL_MAT_ID && ggml_cuda_temporal_unified() && ids != nullptr && ids->type == GGML_TYPE_I32) {
                 const int stride1 = (int) (ids->nb[1] / sizeof(int32_t));
                 int32_t * shared = nullptr;
diff --git a/ggml/src/ggml-cuda/mmvq.cu b/ggml/src/ggml-cuda/mmvq.cu
index e18ada53..0c551835 100644
--- a/ggml/src/ggml-cuda/mmvq.cu
+++ b/ggml/src/ggml-cuda/mmvq.cu
@@ -514,6 +514,11 @@ static __global__ void mul_mat_vec_q(
     channel_x  = ncols_dst == 1 && ids ? ids[channel_dst]                     : fastdiv(channel_dst, channel_ratio);
     channel_y  = ncols_dst == 1 && ids ? fastmodulo(channel_dst, nchannels_y) : channel_dst;
     sample_dst = blockIdx.z;
+    // temporal streaming, TEMPORAL_LOAD_FIRST: a negative id marks an expert position that belongs to the
+    // other pass (resident experts first, incoming experts after their copy); its blocks write nothing
+    if (ncols_dst == 1 && ids && (int32_t) channel_x < 0) {
