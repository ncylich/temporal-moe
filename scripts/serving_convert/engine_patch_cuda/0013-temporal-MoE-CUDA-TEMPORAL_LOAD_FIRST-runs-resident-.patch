diff --git a/ggml/src/ggml-cuda/temporal.cu b/ggml/src/ggml-cuda/temporal.cu
index 8a753bca..dffd6614 100644
--- a/ggml/src/ggml-cuda/temporal.cu
+++ b/ggml/src/ggml-cuda/temporal.cu
@@ -22,6 +22,7 @@ struct TU {
     cudaEvent_t fork = nullptr;                              // fork point on compute stream
     unsigned long long *d_ncopy = nullptr;                   // swap copies issued by k_residency (cumulative)
     int32_t *remap_ids = nullptr; int64_t remap_words = 0;   // persistent remapped-ids buffer, shared gate/up/down
+    int32_t *split_ids = nullptr;                            // TEMPORAL_LOAD_FIRST: [0,K) pass A slot ids, [K,2K) pass B
 };
 static std::vector<TU> g_L;
 static std::unordered_map<const void*, std::pair<int,int>> g_tptr;
@@ -42,6 +43,12 @@ static int tu_overlap() { static int v=[](){ if (getenv("TEMPORAL_UNIFIED_NOOVER
 // GEMMs wait; 2 = that kernel on the compute stream right after the residency scan, no events at all.
 static int tu_lean() { static int v=[](){const char*s=getenv("TEMPORAL_UNIFIED_LEAN");return s?atoi(s):0;}(); return v; }
 static int tr_slots();
+// TEMPORAL_LOAD_FIRST (streamed, routing op on; forces TEMPORAL_ROUTE_SLOTS=2): 1 = the routed experts of a
+// single token run as two passes, resident experts first with no wait, incoming experts after their copies
+// (gate/up fusion kept); 2 = the same, unfused; 3 = graph order only (routing op and copies first, shared
+// expert next), single pass. Off by default.
+int ggml_cuda_temporal_load_first() { static int v=[](){const char*s=getenv("TEMPORAL_LOAD_FIRST");return s?atoi(s):0;}();
+                                      return ggml_cuda_temporal_unified() ? v : 0; }
 int ggml_cuda_temporal_route_op_on();
 int ggml_cuda_temporal_route_mode();
 static int tr_nocopy();
@@ -214,6 +221,30 @@ __global__ void k_force_hist(int* swp_e, int* swp_s, int* nswp, const unsigned*
     if (i < n) { swp_e[i] = (int)((base + (unsigned)i) % (unsigned)E); swp_s[i] = i % R; }
     if (i == 0) *nswp = n;
 }
+// TEMPORAL_SWAP_N / TEMPORAL_SWAP_HIST on the routing-op path (TEMPORAL_ROUTE_SLOTS=2, timing only, output
+// wrong): the routing kernel's swap list is replaced by n cold experts copied into slots 0..n-1 (n pinned, or
+// drawn per layer-token from the histogram as in k_force_hist), and for the two-pass split the positions
+// computed from those slots are the incoming ones.
+__global__ void k_force_route(int* swp_e, int* swp_s, int* nswp, int n_pin, int E, int K, const int32_t* remap, int32_t* split,
+                              const unsigned* cum, int ncum) {
+    const int i = threadIdx.x;
+    __shared__ unsigned base; __shared__ int n;
+    if (i == 0) {
+        int m = n_pin;
+        if (cum) {
+            unsigned x = atomicAdd(&g_hist_step, 1u) + 0x9E3779B9u;
+            x ^= x >> 16; x *= 0x7feb352du; x ^= x >> 15; x *= 0x846ca68bu; x ^= x >> 16;
+            m = 0; while (m < ncum - 1 && x > cum[m]) m++;
+            atomicAdd(&g_hist_cnt[m < 31 ? m : 31], 1ull);
+        }
+        if (m > K) m = K;
+        n = m; base = atomicAdd(&g_hist_base, (unsigned)m);
+    }
+    __syncthreads();
+    if (i < n) { swp_e[i] = (int)((base + (unsigned)i) % (unsigned)E); swp_s[i] = i; }
+    if (i == 0) *nswp = n;
+    if (split && i < K) { const int sl = remap[i]; const bool inc = sl < n; split[i] = inc ? -1 : sl; split[K+i] = inc ? sl : -1; }
+}
 __global__ void k_hist_read(unsigned long long* out) { for (int i = 0; i < 32; ++i) out[i] = g_hist_cnt[i]; }
 static unsigned* g_hist_cum = nullptr; static int g_hist_n = 0;
 static void tu_hist_report() {
@@ -366,6 +397,21 @@ extern "C" int ggml_cuda_temporal_unified_remap(const void* src0_data, const int
     return is_prime ? 2 : 1;   // 2 = prime: caller skips the expert GEMM (copy already issued)
 }
 
+// TEMPORAL_LOAD_FIRST=1|2: slot ids for one pass of a single-token expert op on a registered slot tensor.
+// pass 0 (resident experts) waits for nothing; pass 1 (incoming experts) waits for this tensor's copy, which
+// the routing op issued. Returns 0 when the split does not apply (the caller then takes the single-pass hook).
+extern "C" int ggml_cuda_temporal_split_ids(const void* src0_data, int pass, int n_used, int n_tokens,
+                                            int32_t** ids_out_ptr, cudaStream_t stream) {
+    const int lf = ggml_cuda_temporal_load_first();
+    if (!(lf == 1 || lf == 2) || n_tokens != 1 || !ggml_cuda_temporal_route_op_on()) return 0;
+    auto it = g_tptr.find(src0_data); if (it==g_tptr.end()) return 0;
+    TU& L = g_L[it->second.first]; const int which = it->second.second;
+    if (!L.split_ids || n_used != L.R) return 0;
+    if (pass == 1 && !(ggml_cuda_temporal_route_mode() >= 2 && tr_nocopy() == 2)) cudaStreamWaitEvent(stream, L.ev[which], 0);
+    *ids_out_ptr = L.split_ids + (pass ? n_used : 0);
+    return 1;
+}
+
