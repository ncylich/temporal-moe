                         int* vslot, int* vvalid, int* swp_e, int* swp_s, int* nswp, int32_t* remap,
-                        unsigned long long* ncopy, int free_prefill) {
+                        unsigned long long* ncopy, int free_prefill, int32_t* split, int nocopy) {
     extern __shared__ int sh[];                           // [0,E) logits, [E,2E) resident flag
     float* x = (float*) sh; int* in = sh + E;
     __shared__ unsigned long long s_nom, s_wst; __shared__ int s_cold;
@@ -508,7 +555,11 @@ __global__ void k_route(const float* __restrict__ lg, size_t stride, int n_token
     }
     __syncthreads();
     for (int j=tid; j<K; j+=nt) remap[j]=vslot[j];
-    if (tid==0) { const int ns = s_ns < 0 ? K : s_ns; *nswp=ns; *ncopy+=ns; *vvalid=1; }
+    if (split) for (int j=tid; j<K; j+=nt) {              // the newcomer sits at window position K-1
+        const bool inc = s_ns < 0 || (s_ns == 1 && j == K-1);
