+    } else
     if (ggml_cuda_temporal_unified() && ids != nullptr && ids->type == GGML_TYPE_I32) {
         const int stride1 = (int) (ids->nb[1] / sizeof(int32_t));
         int32_t * shared = nullptr;
@@ -3828,6 +3836,17 @@ static int ggml_cuda_try_fuse(ggml_backend_cuda_context * cuda_ctx, ggml_cgraph
             // mul_mat_id hook does for the unfused ops. Gate first (it runs the residency scan and issues
