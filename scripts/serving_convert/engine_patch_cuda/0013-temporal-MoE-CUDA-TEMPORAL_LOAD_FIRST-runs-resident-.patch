+    // TEMPORAL_LOAD_FIRST=1|2: the routed experts run in two passes over the same selection. Pass A computes
+    // the experts already in their VRAM slots and waits for nothing, so it runs while the copies started at the
+    // routing op are in flight; pass B computes the experts being loaded, after their copies. The backend
+    // gives each pass a slot-id list with the other pass's positions negative (skipped), so every expert is
+    // computed once, by the same kernel, at its own position, and pass B's down projection writes into pass
+    // A's output. Same values and same summation order as the single pass.
+    if (tm_lf_here && (tm_lf == 1 || tm_lf == 2) && up_exps && gate_exps && down_exps && !gate_up_exps
+            && type_op == LLM_FFN_SILU && !up_exps_b && !gate_exps_b && !down_exps_b
+            && !up_exps_s && !gate_exps_s && !down_exps_s && !weight_before_ffn && loras->empty()
+            && !(hparams.swiglu_clamp_exp[il] > 1e-6f)
+            && ggml_is_quantized(up_exps->type) && ggml_is_quantized(gate_exps->type) && ggml_is_quantized(down_exps->type)) {
+        ggml_tensor * x3 = ggml_reshape_3d(ctx0, cur, n_embd, 1, n_tokens);
+        // pass A: resident experts
+        ggml_tensor * up_a = ggml_mul_mat_id(ctx0, up_exps, x3, selected_experts);
+        cb(up_a, "ffn_moe_up", il);
+        ggml_tensor * gate_a = ggml_mul_mat_id(ctx0, gate_exps, x3, selected_experts);
+        cb(gate_a, "ffn_moe_gate", il);
+        ggml_tensor * act_a = ggml_swiglu_split(ctx0, gate_a, up_a);
+        cb(act_a, "ffn_moe_swiglu", il);
+        ggml_tensor * down_a = ggml_mul_mat_id(ctx0, down_exps, act_a, selected_experts);
+        cb(down_a, "ffn_moe_down", il);
+        ggml_build_forward_expand(gf, down_a);
+        // pass B: incoming experts ("_inc" in the name tells the backend which pass a node is)
+        ggml_tensor * up_b = ggml_mul_mat_id(ctx0, up_exps, x3, selected_experts);
+        cb(up_b, "ffn_moe_up_inc", il);
+        ggml_tensor * gate_b = ggml_mul_mat_id(ctx0, gate_exps, x3, selected_experts);
+        cb(gate_b, "ffn_moe_gate_inc", il);
+        ggml_tensor * act_b = ggml_swiglu_split(ctx0, gate_b, up_b);
+        cb(act_b, "ffn_moe_swiglu_inc", il);
+        ggml_tensor * down_b = ggml_view_tensor(ctx0, down_a);     // in place: fills pass A's skipped positions
+        down_b->op     = GGML_OP_MUL_MAT_ID;
+        down_b->src[0] = down_exps;
+        down_b->src[1] = act_b;
+        down_b->src[2] = selected_experts;
+        down_b->src[3] = down_a;                                   // orders pass A first and keeps its buffer
+        cb(down_b, "ffn_moe_down_inc", il);
+        ggml_build_forward_expand(gf, down_b);
+
+        ggml_tensor * experts = ggml_mul(ctx0, down_b, weights);
+        cb(experts, "ffn_moe_weighted", il);
+        ggml_build_forward_expand(gf, experts);
+        ggml_tensor * cur_experts[LLAMA_MAX_EXPERTS] = { nullptr };
+        for (uint32_t i = 0; i < hparams.n_expert_used; ++i) {
+            cur_experts[i] = ggml_view_2d(ctx0, experts, n_embd, n_tokens, experts->nb[2], i*experts->nb[1]);
+            ggml_build_forward_expand(gf, cur_experts[i]);
+        }
+        ggml_tensor * moe_out = cur_experts[0];
+        for (uint32_t i = 1; i < hparams.n_expert_used; ++i) {
+            moe_out = ggml_add(ctx0, moe_out, cur_experts[i]);
+            ggml_build_forward_expand(gf, moe_out);
+        }
+        if (hparams.n_expert_used == 1) {
+            moe_out = ggml_cont(ctx0, moe_out);
+        }
+        cb(moe_out, "ffn_moe_out", il);
+        return moe_out;
+    }
