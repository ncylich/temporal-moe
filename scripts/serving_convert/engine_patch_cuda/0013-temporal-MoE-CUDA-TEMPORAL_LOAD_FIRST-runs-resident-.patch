     if (ggml_cuda_temporal_unified()) {
-        static int fuse=[](){const char*s=getenv("TEMPORAL_UNIFIED_FUSE");return s?atoi(s):0;}();
+        static int fuse=[](){const char*s=getenv("TEMPORAL_UNIFIED_FUSE");return s?atoi(s):0;}() || ggml_cuda_temporal_load_first() == 1;
         if (!fuse || ffn_up_bias || ffn_gate_bias || ffn_up_scale || ffn_gate_scale || ggml_cuda_temporal_router_early()) {
             return false;
         }
@@ -2047,6 +2047,14 @@ static void ggml_cuda_mul_mat_id_impl(ggml_backend_cuda_context & ctx, ggml_tens
     // Phase-3b UNIFIED: if src0 is a registered R-slot expert tensor, remap the selected-expert ids
     // [0,n_expert) -> slot [0,R) before the GEMM (so the mmvq indexes the R-slot VRAM tensor validly).
     ggml_tensor tu_ids_tensor;
+    int32_t * tu_split = nullptr;
+    if (ggml_cuda_temporal_unified() && ids != nullptr && ids->type == GGML_TYPE_I32 &&
+            ggml_cuda_temporal_split_ids(src0->data, strstr(dst->name, "_inc") != nullptr, (int) ids->ne[0], (int) ids->ne[1],
