+                        ggml_backend_tensor_set(rs[w], (const char *) pool3[w]->data, 0, (size_t) R * be);
+                        ggml_cuda_temporal_register(rs[w]->data, pool3[w]->data, be, E, R, il, w);
+                    }
+                    L.ffn_gate_exps = rs[0]; L.ffn_up_exps = rs[1]; L.ffn_down_exps = rs[2];
+                    keep_ctx.push_back(c); keep_buf.push_back(b);
+                    n_done++;
+                }
+                LLAMA_LOG_INFO("%s: temporal UNIFIED reassigned %d MoE layers to R=%d/%d GPU slots\n", __func__, n_done, R, E);
+            }
+        }
+    }
+
     return true;
 }
 
