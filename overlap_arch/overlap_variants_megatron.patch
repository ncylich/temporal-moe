diff --git a/megatron/core/transformer/transformer_config.py b/megatron/core/transformer/transformer_config.py
index 27b4e035..95c41086 100644
--- a/megatron/core/transformer/transformer_config.py
+++ b/megatron/core/transformer/transformer_config.py
@@ -347,6 +347,19 @@ class TransformerConfig(ModelParallelConfig):
     GEMM feature introduced since CUTLASS 2.8 (https://github.com/fanshiqing/grouped_gemm).
     """
 
+    overlap_early_router: bool = False
+    """Overlap-friendly V1 (MoE layers only): compute the MoE router logits from the PRE-attention
+    normalized hidden state (input_layernorm output) instead of the post-attention pre_mlp_layernorm
+    output; experts still process the post-attention stream. Moves the routing decision one sublayer
+    earlier so expert streaming can overlap the attention-compute window. OFF == baseline exactly.
+    """
+
+    overlap_parallel_ffn: bool = False
+    """Overlap-friendly V2 (MoE layers only): PaLM/GPT-J parallel block y = x + Attn(LN1(x)) + MoE(LN2(x)).
+    The MoE branch (and its router) reads the pre-attention layer input x rather than the post-attention
+    hidden state. OFF == baseline exactly.
+    """
+
     moe_use_legacy_grouped_gemm: bool = False
     """Use legacy GroupedMLP rather than TEGroupedMLP.
     Note: The legacy one will be deprecated soon."""
